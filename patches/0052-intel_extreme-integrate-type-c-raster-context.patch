diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiContext.h b/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiContext.h
new file mode 100644
index 00000000..506c78e4
--- /dev/null
+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiContext.h
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef INTEL_EXTREME_ALDER_LAKE_HDMI_CONTEXT_H
+#define INTEL_EXTREME_ALDER_LAKE_HDMI_CONTEXT_H
+#include "AlderLakeHdmiFirmware.h"
+#include "AlderLakeHdmiSequence.h"
+#include "AlderLakeTypeCMmio.h"
+
+// Per-port diagnostic raster context. All methods require accelerant_lock.
+// Owns persistent pipe/port leases and shared power references. No planes are
+// enabled and no framebuffer is fetched. Caller validates firmware, mapping,
+// mode flags and sink timing before construction.
+class AlderLakeHdmiContext {
+public:
+	AlderLakeHdmiContext(volatile uint8* base, size_t bytes, intel_shared_info& shared,
+		const AlderLakeHdmiFirmware& firmware, unsigned pipe)
+		: fFirmware(firmware)
+		, fPipeIndex(pipe)
+		, fMmio(base, bytes, firmware.tcPort, pipe, true)
+		, fIO(fMmio.Ops())
+		, fWell(WellOps(this), firmware.tcPort, 500)
+		, fPortLease(&shared.type_c_port_leases, firmware.tcPort)
+		, fPipeLease(&shared.display_pipe_leases, pipe)
+		, fDisplayPower(fIO, shared.display_power_references, &shared.display_power_owned_requests,
+			  firmware.tcPort, pipe, 500)
+		, fPipe(fIO, pipe, 500)
+		, fSequence(fIO, fWell, fPortLease, firmware.tcPort, pipe, 500)
+		, fActive(false)
+		, fConfigured(false)
+		, fStopping(false)
+		, fHSync(false)
+		, fVSync(false)
+		, fStage("idle")
+	{
+	}
+	status_t Start(const AlderLakeHdmiTiming& timing, bool hsync, bool vsync)
+	{
+		fStage = "prior cleanup";
+		if (fActive || fStopping || fSequence.NeedsCleanup())
+			return B_BUSY;
+		if (fPipeIndex > 2 || fFirmware.tcPort < 1 || fFirmware.tcPort > 4)
+			return B_BAD_VALUE;
+		// Inspect only already-powered pipe registers. Do not touch an active
+		// firmware pipe or any plane/cursor that may fetch memory.
+		fStage = "parent power";
+		uint32 main, dc;
+		status_t s = fIO.read(fIO.cookie, 0x45404, &main);
+		if (s != B_OK)
+			return s;
+		s = fIO.read(fIO.cookie, 0x45504, &dc);
+		if (s != B_OK)
+			return s;
+		uint32 states = 1U | (1U << 2) | (1U << (2 * (fPipeIndex + 5)));
+		if (main == 0xffffffffU || dc == 0xffffffffU || (main & states) != states
+			|| (dc & 0x2000000bU))
+			return B_BUSY;
+		fStage = "pipe disabled";
+		uint32 control;
+		s = fIO.read(fIO.cookie, 0x70008U + fPipeIndex * 0x1000U, &control);
+		if (s != B_OK)
+			return s;
+		if (control & 0xc0000000U)
+			return B_BUSY;
+		fStage = "all planes disabled";
+		for (unsigned plane = 0; plane < 7; plane++) {
+			s = fIO.read(fIO.cookie, 0x70180U + fPipeIndex * 0x1000U + plane * 0x100U, &control);
+			if (s != B_OK)
+				return s;
+			if (control == 0xffffffffU || (control & 0x80000000U))
+				return B_BUSY;
+		}
+		fStage = "cursor disabled";
+		s = fIO.read(fIO.cookie, 0x70080U + fPipeIndex * 0x1000U, &control);
+		if (s != B_OK)
+			return s;
+		if (control == 0xffffffffU || (control & 0x3fU))
+			return B_BUSY;
+		s = fSequence.Begin(fFirmware.pixelClockKHz, fFirmware.referenceKHz, fFirmware.preset,
+			fFirmware.loadgenWorkaround, hsync, vsync, fFirmware.laneReversal, &fPipe, &timing,
+			&fPipeLease, &fDisplayPower, true);
+		fStage = fSequence.Stage();
+		if (s == B_OK) {
+			fActive = true;
+			fConfigured = true;
+			fTiming = timing;
+			fHSync = hsync;
+			fVSync = vsync;
+		} else if (fSequence.NeedsCleanup())
+			fStopping = true;
+		return s;
+	}
+	status_t Stop()
+	{
+		fStopping = true;
+		status_t s = fSequence.End();
+		if (s == B_OK) {
+			fActive = false;
+			fStopping = false;
+		}
+		return s;
+	}
+	status_t Resume()
+	{
+		if (fStopping)
+			return B_BUSY;
+		if (fActive)
+			return B_OK;
+		if (!fConfigured)
+			return B_ERROR;
+		return Start(fTiming, fHSync, fVSync);
+	}
+	bool IsActive() const
+	{
+		return fActive && !fStopping;
+	}
+	bool NeedsCleanup() const
+	{
+		return fSequence.NeedsCleanup();
+	}
+	const char* Stage() const
+	{
+		return fStage;
+	}
+
+private:
+	static status_t WellRead(void* p, uint32* value)
+	{
+		AlderLakeHdmiContext& c = *(AlderLakeHdmiContext*)p;
+		return c.fIO.read(c.fIO.cookie, 0x45444, value);
+	}
+	static status_t WellWrite(void* p, uint32 value)
+	{
+		AlderLakeHdmiContext& c = *(AlderLakeHdmiContext*)p;
+		return c.fIO.write(c.fIO.cookie, 0x45444, value);
+	}
+	static void Pause(void* p)
+	{
+		AlderLakeHdmiContext& c = *(AlderLakeHdmiContext*)p;
+		c.fIO.pause(c.fIO.cookie);
+	}
+	static TypeCPowerWellOps WellOps(void* cookie)
+	{
+		TypeCPowerWellOps ops = { cookie, WellRead, WellWrite, Pause };
+		return ops;
+	}
+	AlderLakeHdmiContext(const AlderLakeHdmiContext&);
+	AlderLakeHdmiContext& operator=(const AlderLakeHdmiContext&);
+	AlderLakeHdmiFirmware fFirmware;
+	unsigned fPipeIndex;
+	AlderLakeTypeCMmio fMmio;
+	AlderLakeTypeCIO fIO;
+	TypeCPowerWell fWell;
+	TypeCPortLease fPortLease;
+	DisplayPipeLease fPipeLease;
+	AlderLakeDisplayPower fDisplayPower;
+	AlderLakeHdmiPipe fPipe;
+	AlderLakeHdmiSequence fSequence;
+	bool fActive, fConfigured, fStopping, fHSync, fVSync;
+	AlderLakeHdmiTiming fTiming;
+	const char* fStage;
+};
+#endif
diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiSequence.h b/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiSequence.h
