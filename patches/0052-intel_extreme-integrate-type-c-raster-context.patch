+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCMmio.h
@@ -68,7 +68,13 @@ private:
 			|| offset == plane + 0x19cU || offset == plane + 0x27cU
 			|| offset == plane + 0x240U)
 			return !write;
-		if (offset == 0x45504U || offset == 0x45404U || offset == 0x45454U)
+		if (offset == 0x45504U)
+			return !write;
+		if (offset == 0x45404U || offset == 0x45454U)
+			return true;
+		if (offset == plane + 0x80U
+			|| (offset >= plane + 0x180U && offset <= plane + 0x780U
+				&& (offset - plane - 0x180U) % 0x100U == 0))
 			return !write;
 		if (offset == 0x161500U + (fPort - 1) * 4U)
 			return !write;
@@ -93,6 +99,14 @@ private:
 	{
 		AlderLakeTypeCMmio& self = *(AlderLakeTypeCMmio*)cookie;
 		if (!self.Allowed(offset, true)) return B_BAD_VALUE;
+		if (offset == 0x45404U || offset == 0x45454U) {
+			const uint32 allowed = offset == 0x45404U
+				? 2U | (2U << 2) | (2U << (2 * (self.fPipe + 5)))
+				: 2U << (2 * (self.fPort + 2));
+			uint32 current = *(volatile uint32*)(self.fBase + offset);
+			if (current == 0xffffffffU || ((value ^ current) & ~allowed) != 0)
+				return B_BAD_VALUE;
+		}
 		if (offset == 0x1010a0U) {
 			unsigned shift = (self.fPort - 1) * 8;
 			if ((value & ~(0xfU << shift)) != 0 || (value >> shift) > 2)
diff --git a/src/add-ons/accelerants/intel_extreme/Ports.cpp b/src/add-ons/accelerants/intel_extreme/Ports.cpp
index 27d2e1e1..4447a2b9 100644
--- a/src/add-ons/accelerants/intel_extreme/Ports.cpp
+++ b/src/add-ons/accelerants/intel_extreme/Ports.cpp
@@ -27,6 +27,8 @@
 #include "PanelFitter.h"
 #include "TigerLakePLL.h"
 #include "AlderLakeHdmiFirmware.h"
+#include "AlderLakeHdmiContext.h"
+#include <unistd.h>
 #include "AlderLakeHdmiPowerPrerequisites.h"
 #include "AlderLakeTypeCMmio.h"
 
@@ -2221,13 +2223,36 @@ EmbeddedDisplayPort::IsConnected()
 DigitalDisplayInterface::DigitalDisplayInterface(port_index index,
 		const char* baseName)
 	:
-	Port(index, baseName)
+	Port(index, baseName),
+	fHdmiContext(NULL)
 {
 	// As of Haswell, Intel decided to change eDP ports to a "DDI" bus...
 	// on a dare because the hardware engineers were drunk one night.
 }
 
 
+DigitalDisplayInterface::~DigitalDisplayInterface()
+{
+	if (fHdmiContext == NULL)
+		return;
+	Autolock locker(gInfo->shared_info->accelerant_lock);
+	if (locker.IsLocked() && fHdmiContext->Stop() == B_OK)
+		delete fHdmiContext;
+	else
+		ERROR("HDMI raster cleanup incomplete; references retained until recovery\n");
+}
+
+
+static bool
+request_type_c_raster(port_index port)
+{
+	return gInfo->has_shared_layout
+		&& gInfo->shared_info->device_type.IsModel(INTEL_MODEL_ALDM)
+		&& (port == INTEL_PORT_F || port == INTEL_PORT_G)
+		&& access("/boot/home/config/settings/intel_extreme_tc_raster_test", F_OK) == 0;
+}
+
+
 addr_t
 DigitalDisplayInterface::_PortRegister()
 {
@@ -2274,6 +2299,12 @@ DigitalDisplayInterface::_DDCRegister()
 status_t
 DigitalDisplayInterface::Power(bool enabled)
 {
+	if (fHdmiContext != NULL || request_type_c_raster(PortIndex())) {
+		if (fHdmiContext == NULL)
+			return enabled ? B_ERROR : B_OK;
+		return enabled ? fHdmiContext->Resume() : fHdmiContext->Stop();
+	}
+
 	if (fPipe == NULL) {
 		ERROR("%s: Setting power without assigned pipe!\n", __func__);
 		return B_ERROR;
@@ -2644,9 +2675,48 @@ DigitalDisplayInterface::_SetPortLinkGen8(const display_timing& timing, uint32 p
 	return B_OK;
 }
 
+status_t
+DigitalDisplayInterface::_SetRasterMode(display_mode* mode)
+{
+	if (fHdmiContext != NULL) {
+		status_t status = fHdmiContext->Stop();
+		if (status != B_OK)
+			return status;
+		delete fHdmiContext;
+		fHdmiContext = NULL;
+	}
+	AlderLakeHdmiFirmware firmware;
+	status_t status = ReadAlderLakeHdmiFirmware(gInfo->shared_info,
+		gInfo->has_shared_layout, PortIndex(), mode->timing.pixel_clock, &firmware);
+	if (status != B_OK || mode->timing.pixel_clock > 165000
+		|| (mode->timing.flags & B_TIMING_INTERLACED) != 0
+		|| !HasEDID() || fEDIDInfo.display.input_type != 1
+		|| fPipe->Index() < INTEL_PIPE_A || fPipe->Index() > INTEL_PIPE_C)
+		return B_BAD_VALUE;
+	area_info area;
+	if (get_area_info(gInfo->regs_area, &area) != B_OK || area.address != gInfo->registers)
+		return B_BAD_VALUE;
+	fHdmiContext = new(std::nothrow) AlderLakeHdmiContext(gInfo->registers, area.size,
+		*gInfo->shared_info, firmware, fPipe->Index() - INTEL_PIPE_A);
+	if (fHdmiContext == NULL)
+		return B_NO_MEMORY;
+	const display_timing& t = mode->timing;
+	AlderLakeHdmiTiming timing = {t.h_display, t.h_sync_start, t.h_sync_end, t.h_total,
+		t.v_display, t.v_sync_start, t.v_sync_end, t.v_total};
+	status = fHdmiContext->Start(timing, (t.flags & B_POSITIVE_HSYNC) != 0,
+		(t.flags & B_POSITIVE_VSYNC) != 0);
+	TRACE("ADL HDMI raster: stage=%s status=%" B_PRId32
+		" cleanup=%u (no planes enabled)\n", fHdmiContext->Stage(), status,
+		(unsigned)fHdmiContext->NeedsCleanup());
+	if (status == B_OK)
+		memcpy(&fCurrentMode, mode, sizeof(display_mode));
+	return status;
+}
+
+
