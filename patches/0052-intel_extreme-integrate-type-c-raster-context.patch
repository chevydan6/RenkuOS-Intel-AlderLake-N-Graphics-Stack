-// This preflight uses the existing BAR mapping and reads only. Output execution
-// stays disabled until plane programming and HDMI packet setup are integrated.
+// This preflight uses the existing BAR mapping and reads only. The separate
+// opt-in raster path sends DVI-compatible TMDS without enabling memory planes.
 static void
 diagnose_alder_lake_hdmi(port_index port, pipe_index pipe, uint32 pixelClock)
 {
@@ -2731,6 +2801,9 @@ DigitalDisplayInterface::SetDisplayMode(display_mode* target, uint32 colorMode)
 
 	diagnose_alder_lake_hdmi(PortIndex(), fPipe->Index(), target->timing.pixel_clock);
 
+	if (fHdmiContext != NULL || request_type_c_raster(PortIndex()))
+		return _SetRasterMode(target);
+
 	display_timing hardwareTarget = target->timing;
 	bool needsScaling = false;
 	if ((PortIndex() == INTEL_PORT_A)
