 		  fPower(fBackend.LifecycleOps()), fPll(io, tcPort, attempts), fClock(io, tcPort),
 		  fTranscoder(io, pipe), fSignal(io, tcPort),
-		  fBuffer(io, tcPort, attempts), fPort(tcPort), fPipe(pipe), fStarted(false), fIO(io), fPipeStage(NULL), fPipeLease(NULL), fDisplayPower(NULL)
+		  fBuffer(io, tcPort, attempts), fPort(tcPort), fPipe(pipe), fStarted(false), fIO(io), fPipeStage(NULL), fPipeLease(NULL), fDisplayPower(NULL), fStage("idle")
 	{
 	}
 
@@ -39,6 +39,7 @@ public:
 		DisplayPipeLease* pipeLease = NULL,
 		AlderLakeDisplayPower* displayPower = NULL, bool dviCompatible = false)
 	{
+		fStage = "validation";
 		if (fStarted || fLease.IsHeld() || fPower.NeedsCleanup() || fPll.NeedsCleanup()
 			|| fClock.NeedsCleanup()
 			|| fTranscoder.NeedsCleanup() || fSignal.NeedsCleanup()
@@ -70,13 +71,15 @@ public:
 			loadgenWorkaround, &signalPlan);
 		if (status != B_OK) return status;
 
+		fStage = "port lease";
 		status = fLease.Acquire();
 		if (status != B_OK) return status;
 		fStarted = true;
 		fPipeStage = pipeStage;
 		fPipeLease = pipeLease;
 		if (fPipeLease != NULL) {
-			status = fPipeLease->Acquire();
+			fStage = "pipe lease";
+		status = fPipeLease->Acquire();
 			if (status != B_OK) {
 				fPipeStage = NULL;
 				fPipeLease = NULL;
@@ -85,31 +88,41 @@ public:
 		}
 		fDisplayPower = displayPower;
 		if (fDisplayPower != NULL) {
-			status = fDisplayPower->Acquire();
+			fStage = "display power";
+		status = fDisplayPower->Acquire();
 			if (status != B_OK) return Fail(status);
 			status = CheckAlderLakeHdmiPowerPrerequisites(fIO, fPort, fPipe);
 			if (status != B_OK) return Fail(status);
 		}
+		fStage = "AUX/PHY ownership";
 		status = fPower.Acquire();
 		if (status != B_OK) return Fail(status);
+		fStage = "Dekel PLL";
 		status = fPll.Program(pllPlan);
 		if (status != B_OK) return Fail(status);
+		fStage = "port clock";
 		status = fClock.Enable();
 		if (status != B_OK) return Fail(status);
 		if (fPipeStage != NULL) {
-			status = fPipeStage->Prepare(*timing);
+			fStage = "pipe timing";
+		status = fPipeStage->Prepare(*timing);
 			if (status != B_OK) return Fail(status);
 		}
+		fStage = "transcoder configure";
 		status = fTranscoder.Configure(transPlan);
 		if (status != B_OK) return Fail(status);
+		fStage = "transcoder function";
 		status = fTranscoder.Enable();
 		if (status != B_OK) return Fail(status);
 		if (fPipeStage != NULL) {
-			status = fPipeStage->Enable();
+			fStage = "pipe enable";
+		status = fPipeStage->Enable();
 			if (status != B_OK) return Fail(status);
 		}
+		fStage = "PHY signal";
 		status = fSignal.Apply(preset, pixelClockKHz, loadgenWorkaround);
 		if (status != B_OK) return Fail(status);
+		fStage = "DDI buffer";
 		status = fBuffer.Enable(laneReversal);
 		if (status != B_OK) return Fail(status);
 		return B_OK;
@@ -153,6 +166,9 @@ public:
 		return B_OK;
 	}
 
+	bool NeedsCleanup() const { return fStarted; }
+	const char* Stage() const { return fStage; }
+
 private:
 	status_t Fail(status_t cause)
 	{
@@ -176,6 +192,7 @@ private:
 	AlderLakeHdmiPipe* fPipeStage;
 	DisplayPipeLease* fPipeLease;
 	AlderLakeDisplayPower* fDisplayPower;
+	const char* fStage;
 };
 
 #endif
diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCMmio.h b/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCMmio.h
index b2459b2e..e0ac099d 100644
