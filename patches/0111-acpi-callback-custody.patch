+ acquire_spinlock(&sDPCAdmissionLock);
+ ACPIDPCCallback* record = NULL;
+ if (sDPCPhase == DPCOpen && sDPCProducers != ~(uint32)0
+  && sDPCCallbackCount != ~(uint32)0) {
