+// Bounded image-owned reservations: no heap allocation or waits in interrupt context.
+// A zero reference count permits slot reuse, NEVER image/dependency release.
+struct ACPIDPCCallback {
+ void (*function)(void*);
+ void* context;
+ uint32 references;
+};
+static ACPIDPCCallback sDPCCallbacks[64];
+static uint32 sDPCCallbackCount = 0;
