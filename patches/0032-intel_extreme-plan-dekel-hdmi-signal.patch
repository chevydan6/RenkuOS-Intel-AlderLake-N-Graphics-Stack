From b32c01086eecc5b360172f44d5a90dcecf76ed69 Mon Sep 17 00:00:00 2001
From: RenkuOS GPU Development <gpu-development@localhost>
Date: Fri, 6 Nov 2026 17:38:31 +0900
Subject: [PATCH] intel_extreme: plan Dekel HDMI signal levels

---
 .../intel_extreme/DekelHdmiSignal.h           | 50 +++++++++++++++++++
 .../intel_extreme/DekelIntelLicense.txt       |  1 +
 2 files changed, 51 insertions(+)
 create mode 100644 src/add-ons/accelerants/intel_extreme/DekelHdmiSignal.h

diff --git a/src/add-ons/accelerants/intel_extreme/DekelHdmiSignal.h b/src/add-ons/accelerants/intel_extreme/DekelHdmiSignal.h
new file mode 100644
index 00000000..656d6b28
--- /dev/null
+++ b/src/add-ons/accelerants/intel_extreme/DekelHdmiSignal.h
@@ -0,0 +1,50 @@
+/*
