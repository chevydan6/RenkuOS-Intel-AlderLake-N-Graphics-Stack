+	ACPI_DMAR_ABSENT, ACPI_DMAR_DUPLICATE, ACPI_DMAR_UNSUPPORTED,
+	ACPI_DMAR_NOT_READY, ACPI_DMAR_MUTEX_FAILURE
+};
+typedef struct acpi_dmar_descriptor_module_info {
+	module_info info;
+	acpi_dmar_descriptor_result (*classify)(uint32* acpicaStatus);
+} acpi_dmar_descriptor_module_info;
