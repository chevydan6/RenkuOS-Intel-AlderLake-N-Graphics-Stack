+// Lifecycle admission retains existing image/dependency custody across closure.
+acpi_dmar_descriptor_result
+acpi_classify_dmar(uint32* acpicaStatus)
+{
+	*acpicaStatus = AE_OK;
+	cpu_status irq = disable_interrupts();
+	acquire_spinlock(&sACPILifecycleLock);
+	bool admitted = sACPILifecycle == ACPIReady;
+	release_spinlock(&sACPILifecycleLock);
+	restore_interrupts(irq);
+	if (!admitted)
+		return ACPI_DMAR_NOT_READY;
+
+	ACPI_STATUS status = AcpiUtAcquireMutex(ACPI_MTX_TABLES);
+	*acpicaStatus = status;
+	if (ACPI_FAILURE(status))
+		return ACPI_DMAR_MUTEX_FAILURE;
+
+	// Address and stored Signature are metadata; never follow Pointer/Address.
+	const UINT32 count = AcpiGbl_RootTableList.CurrentTableCount;
+	acpi_dmar_descriptor_result result = ACPI_DMAR_ABSENT;
+	for (UINT32 i = 0; i < count; i++) {
+		const ACPI_TABLE_DESC* descriptor = &AcpiGbl_RootTableList.Tables[i];
+		if (descriptor->Address == 0
+			|| memcmp(descriptor->Signature.Ascii, "DMAR", 4) != 0)
+			continue;
+		if (result == ACPI_DMAR_UNSUPPORTED) {
+			result = ACPI_DMAR_DUPLICATE;
+			break;
+		}
+		result = ACPI_DMAR_UNSUPPORTED;
+	}
+	AcpiUtReleaseMutex(ACPI_MTX_TABLES);
+	return result;
+}
