+static bool
+ReadBcsRegister(void* data, uint32_t offset, uint32_t& value)
+{
+	HandshakeContext& context = *(HandshakeContext*)data;
+	bool allowed = false;
+	for (unsigned i = 0; i < 5; i++)
+		allowed |= offset == kIntelN100BcsOffsets[i];
+	uint64 now = HandshakeTime(NULL);
+	if (!allowed || (offset & 3) != 0
+		|| uint64(offset) + sizeof(uint32) > context.device.size
+		|| context.registers > UINTPTR_MAX - offset - 3
+		|| now == UINT64_MAX || now < context.sampleLastTime
+		|| now >= context.sampleDeadline) {
+		context.sampleUncertain = true;
+		return false;
+	}
+	context.sampleLastTime = now;
+	if (!HandshakeLive(data))
+		return false;
+	memory_read_barrier();
+	value = *(const volatile uint32*)(context.registers + offset);
+	memory_read_barrier();
+	now = HandshakeTime(NULL);
+	if (value == UINT32_MAX || now == UINT64_MAX
+		|| now < context.sampleLastTime || now >= context.sampleDeadline) {
+		context.sampleUncertain = true;
+		return false;
+	}
+	context.sampleLastTime = now;
+	return true;
+}
