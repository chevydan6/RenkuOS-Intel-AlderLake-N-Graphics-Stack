diff --git a/src/add-ons/kernel/bus_managers/intel_memory_owner/IntelMemoryOwner.cpp b/src/add-ons/kernel/bus_managers/intel_memory_owner/IntelMemoryOwner.cpp
--- a/src/add-ons/kernel/bus_managers/intel_memory_owner/IntelMemoryOwner.cpp
+++ b/src/add-ons/kernel/bus_managers/intel_memory_owner/IntelMemoryOwner.cpp
@@ -107,8 +107,13 @@
 ReleaseDisplay(uint64 lease)
 {
 	mutex_lock(&sLock);
-	status_t result = Status(sState.Release(lease));
+	IntelApertureLeaseState::Result release = sState.Release(lease);
+	if (release == IntelApertureLeaseState::Busy)
+		release = sState.AbortInitialization(lease);
+	status_t result = Status(release);
 	mutex_unlock(&sLock);
+	// Success means lease revocation, including aborted initialization.
+	// Existing operation tickets still retain their pins until completion.
 	// Last close is not scanout-idle evidence. Keep MMIO, GART and backing.
 	return result;
 }
