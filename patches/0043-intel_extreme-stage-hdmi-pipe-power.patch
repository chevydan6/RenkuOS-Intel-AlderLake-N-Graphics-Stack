--- a/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCMmio.h
+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCMmio.h
@@ -58,6 +58,12 @@ private:
 	bool Allowed(uint32 offset, bool write) const
 	{
 		if (!Valid(offset)) return false;
+		if ((offset >= 0x60000U + fPipe * 0x1000U
+			&& offset <= 0x60014U + fPipe * 0x1000U)
+			|| offset == 0x70008U + fPipe * 0x1000U)
+			return true;
+		if (offset == 0x45504U || offset == 0x45404U || offset == 0x45454U)
+			return !write;
 		if (offset == 0x161500U + (fPort - 1) * 4U)
 			return !write;
 		if (offset == 0x45444U || offset == 0x1010a0U
