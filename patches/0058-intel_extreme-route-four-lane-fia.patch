--- /dev/null
+++ b/src/add-ons/accelerants/intel_extreme/TypeCFiaLaneCount.h
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef INTEL_EXTREME_TYPE_C_FIA_LANE_COUNT_H
+#define INTEL_EXTREME_TYPE_C_FIA_LANE_COUNT_H
+#include "AlderLakeTypeCBackend.h"
+
+// ADL-P modular FIA owns two ports per instance. For legacy four-lane TMDS,
+// set only this port's DPMLETC nibble. Parent and AUX power, PHY ownership,
+// readiness and the exclusive port/register lock must be held throughout.
+class TypeCFiaLaneCount {
+public:
+	TypeCFiaLaneCount(const AlderLakeTypeCIO& io, unsigned port)
+		: fIO(io)
+		, fPort(port)
+		, fSaved(0)
+		, fInitial(0)
+		, fHeld(false)
+	{
+	}
+	status_t Apply()
+	{
+		if (fHeld)
+			return B_BUSY;
+		if (fPort < 1 || fPort > 4 || !fIO.read || !fIO.write)
+			return B_BAD_VALUE;
+		uint32 value;
+		status_t s = Read(0x161500U + (fPort - 1) * 4, &value);
+		if (s != B_OK)
+			return s;
+		if (!(value & 4))
+			return B_BUSY;
+		s = Read(0x64300U + (fPort - 1) * 0x100, &value);
+		if (s != B_OK)
+			return s;
+		if ((value & 0x80000000U) || !(value & 0x40U))
+			return B_BUSY;
+		s = Read(Offset(), &value);
+		if (s != B_OK)
+			return s;
+		fInitial = value;
+		fSaved = value & Mask();
+		uint32 next = value | Mask();
+		if (next != value) {
+			s = fIO.write(fIO.cookie, Offset(), next);
+			if (s != B_OK)
+				return s;
+		}
+		fHeld = true;
+		s = Read(Offset(), &value);
+		if (s != B_OK)
+			return Fail(s);
+		if ((value & Mask()) != Mask())
+			return Fail(B_ERROR);
+		return B_OK;
+	}
+	status_t Restore()
+	{
+		if (!fHeld)
+			return B_OK;
+		uint32 value;
+		status_t s = Read(Offset(), &value);
+		if (s != B_OK)
+			return s;
+		uint32 next = (value & ~Mask()) | fSaved;
+		if (next != value) {
+			s = fIO.write(fIO.cookie, Offset(), next);
+			if (s != B_OK)
+				return s;
+		}
+		s = Read(Offset(), &value);
+		if (s != B_OK)
+			return s;
+		if ((value & Mask()) != fSaved)
+			return B_ERROR;
+		fHeld = false;
+		return B_OK;
+	}
+	uint32 InitialValue() const
+	{
+		return fInitial;
+	}
+	bool NeedsCleanup() const
+	{
+		return fHeld;
+	}
+
+private:
+	uint32 Offset() const
+	{
+		return fPort <= 2 ? 0x1638c0U : 0x16e8c0U;
+	}
+	uint32 Mask() const
+	{
+		return 0xfU << (4 * ((fPort - 1) % 2));
+	}
+	status_t Read(uint32 offset, uint32* value)
+	{
+		status_t s = fIO.read(fIO.cookie, offset, value);
+		return s == B_OK && *value == 0xffffffffU ? B_ERROR : s;
+	}
+	status_t Fail(status_t cause)
+	{
+		status_t s = Restore();
+		return s == B_OK ? cause : s;
+	}
+	TypeCFiaLaneCount(const TypeCFiaLaneCount&);
+	TypeCFiaLaneCount& operator=(const TypeCFiaLaneCount&);
+	AlderLakeTypeCIO fIO;
+	unsigned fPort;
+	uint32 fSaved, fInitial;
+	bool fHeld;
+};
+#endif
