From ed1df026de442d7f26a7b2b345554ddcd280d12f Mon Sep 17 00:00:00 2001
From: RenkuOS GPU Development <gpu-development@localhost>
Date: Fri, 6 Nov 2026 16:52:40 +0900
Subject: [PATCH] intel_extreme: bound display PLL state waits

---
 .../accelerants/intel_extreme/Ports.cpp       |  4 ++-
 .../intel_extreme/TigerLakePLL.cpp            | 28 +++++++++++++++++--
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/src/add-ons/accelerants/intel_extreme/Ports.cpp b/src/add-ons/accelerants/intel_extreme/Ports.cpp
index c682cb24..2091449e 100644
--- a/src/add-ons/accelerants/intel_extreme/Ports.cpp
+++ b/src/add-ons/accelerants/intel_extreme/Ports.cpp
@@ -2761,7 +2761,9 @@ DigitalDisplayInterface::SetDisplayMode(display_mode* target, uint32 colorMode)
 			chosenPLL = 1;
 		TRACE("Using DPLL %d for port %d. PLL settings: DCO=%f, P,Q,K=%d,%d,%d\n", chosenPLL,
 			PortIndex(), dco, p, q, k);
-		ProgramPLL(chosenPLL, p, q, k, dco);
+		status_t pllStatus = ProgramPLL(chosenPLL, p, q, k, dco);
+		if (pllStatus != B_OK)
+			return pllStatus;
 
 		// Configure DPLL mapping to port then turn on DPLL clock
 		uint32 config = read32(TGL_DPCLKA_CFGCR0);
diff --git a/src/add-ons/accelerants/intel_extreme/TigerLakePLL.cpp b/src/add-ons/accelerants/intel_extreme/TigerLakePLL.cpp
index 8fef3fab..7ebaa9a7 100644
--- a/src/add-ons/accelerants/intel_extreme/TigerLakePLL.cpp
+++ b/src/add-ons/accelerants/intel_extreme/TigerLakePLL.cpp
@@ -22,6 +22,19 @@
 #define CALLED(x...) TRACE("CALLED %s\n", __PRETTY_FUNCTION__)
 
 
+static bool
+wait_for_pll_state(uint32 reg, uint32 mask, bool set)
+{
+	// A broken or unpowered PLL must not hang app_server indefinitely.
+	for (int attempt = 0; attempt < 2000; attempt++) {
+		if (((read32(reg) & mask) != 0) == set)
+			return true;
+		snooze(10);
+	}
+	return false;
+}
+
+
 /**
  * Compute the best PLL parameters for a given symbol clock frequency for a DVI or HDMI port.
  *
@@ -304,14 +317,20 @@ ProgramPLL(int which, int Pdiv, int Qdiv, int Kdiv, float dco)
 
 	// Before we start, disable the PLL
 	write32(DPLL_ENABLE, read32(DPLL_ENABLE) & ~TGL_DPLL_ENABLE);
-	while ((read32(DPLL_ENABLE) & TGL_DPLL_LOCK) != 0);
+	if (!wait_for_pll_state(DPLL_ENABLE, TGL_DPLL_LOCK, false)) {
+		ERROR("%s: timed out waiting for PLL unlock\n", __func__);
+		return B_TIMED_OUT;
+	}
 	TRACE("PLL is unlocked\n");
 
 	// Enable PLL power
 	write32(DPLL_ENABLE, read32(DPLL_ENABLE) | TGL_DPLL_POWER_ENABLE);
 
 	// Wait for PLL to be powered up
-	while ((read32(DPLL_ENABLE) & TGL_DPLL_POWER_STATE) == 0);
+	if (!wait_for_pll_state(DPLL_ENABLE, TGL_DPLL_POWER_STATE, true)) {
+		ERROR("%s: timed out waiting for PLL power\n", __func__);
+		return B_TIMED_OUT;
+	}
 	TRACE("PLL is powered on\n");
 
 	// Deactivate spread spectrum
@@ -336,7 +355,10 @@ ProgramPLL(int which, int Pdiv, int Qdiv, int Kdiv, float dco)
 	TRACE("DPLL_ENABLE(%" B_PRIx32 ") = %" B_PRIx32 "\n", DPLL_ENABLE, read32(DPLL_ENABLE));
 
 	// Wait for PLL to be enabled
-	while ((read32(DPLL_ENABLE) & TGL_DPLL_LOCK) == 0);
+	if (!wait_for_pll_state(DPLL_ENABLE, TGL_DPLL_LOCK, true)) {
+		ERROR("%s: timed out waiting for PLL lock\n", __func__);
+		return B_TIMED_OUT;
+	}
 	TRACE("PLL is locked\n");
 
 	// TODO Display voltage frequency switching?
-- 
2.43.0

