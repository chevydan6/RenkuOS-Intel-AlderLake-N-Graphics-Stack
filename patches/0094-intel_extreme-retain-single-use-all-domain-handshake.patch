+
+static bool
+GroupAccessAllowed(GroupContext& context, uint32 offset, bool write)
+{
+	bool allowed = false;
+	for (unsigned i = 0; i < context.plan.count; i++)
+		allowed |= offset == (write ? context.plan.domains[i].request : context.plan.domains[i].ack);
+	return allowed && (offset & 3) == 0
+		&& uint64(offset) + sizeof(uint32) <= context.handshake->device.size
+		&& context.handshake->registers <= UINTPTR_MAX - offset - 3;
+}
+
+static bool
+GroupRead(void* data, uint32_t offset, uint32_t& value)
+{
+	GroupContext& context = *(GroupContext*)data;
+	if (!GroupAccessAllowed(context, offset, false))
+		return false;
+	memory_read_barrier();
+	value = *(const volatile uint32*)(context.handshake->registers + offset);
+	memory_read_barrier();
+	return value != UINT32_MAX;
+}
+
+static bool
+GroupWrite(void* data, uint32_t offset, uint32_t word)
+{
+	GroupContext& context = *(GroupContext*)data;
+	if (!GroupAccessAllowed(context, offset, true) || (word != 0x10001 && word != 0x10000))
+		return false;
+	// The group ledger records attempted ownership before this callback.
+	memory_write_barrier();
+	*(volatile uint32*)(context.handshake->registers + offset) = word;
+	memory_full_barrier();
+	return true;
+}
