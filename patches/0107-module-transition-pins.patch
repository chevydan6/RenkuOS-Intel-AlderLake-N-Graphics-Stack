+// Private, allocation-free reservations. All operations retain sModulesLock.
+// Active metadata and image pins are distinct from public references.
+struct module_transition {
+	module* target;
+	module_image* image;
+	module_info* info;
+	unsigned long long generation;
+	int state;
+};
+
+static status_t
+check_module_transition(module* target)
+{
+	if (target->transition_active || target->lifecycle_retained
+		|| target->transition_generation == ~0ULL
+		|| (target->module_image != NULL
+			&& target->module_image->transition_pins == ~0U))
+		return B_BUSY;
+	return B_OK;
+}
+
+static status_t
+reserve_module_transition(module* target, int state, module_transition& ticket)
+{
+	status_t status = check_module_transition(target);
+	if (status != B_OK)
+		return status;
+	ticket = {target, target->module_image, target->info,
+		++target->transition_generation, state};
+	target->transition_active = true;
+	if (ticket.image != NULL)
+		ticket.image->transition_pins++;
+	target->state = state;
+	return B_OK;
+}
+
+static bool
+validate_module_transition(const module_transition& ticket)
+{
+	module* target = ticket.target;
+	return target->transition_active
+		&& target->transition_generation == ticket.generation
+		&& target->module_image == ticket.image && target->info == ticket.info
+		&& target->state == ticket.state
+		&& (ticket.image == NULL || ticket.image->transition_pins != 0);
+}
+
+static status_t
+commit_module_transition(module_transition& ticket, status_t status)
+{
+	module* target = ticket.target;
+	if (!validate_module_transition(ticket))
+		status = B_ERROR;
+	if (status < B_OK) {
+		// Uncertain identity or callback failure: never release or replay pins.
+		target->lifecycle_retained = true;
+		target->state = MODULE_ERROR;
+		if (ticket.image != NULL) {
+			ticket.image->lifecycle_retained = true;
+			ticket.image->dependency_state = DependenciesQuarantined;
+		}
+		return status;
+	}
+	target->state = ticket.state == MODULE_INIT ? MODULE_READY : MODULE_LOADED;
+	target->transition_active = false;
+	if (ticket.image != NULL)
+		ticket.image->transition_pins--;
+	return status;
+}
+
