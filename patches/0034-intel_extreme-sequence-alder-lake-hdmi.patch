+#ifndef INTEL_EXTREME_ALDER_LAKE_HDMI_SEQUENCE_H
+#define INTEL_EXTREME_ALDER_LAKE_HDMI_SEQUENCE_H
+
+#include "DekelHdmiPllProgrammer.h"
+#include "DekelHdmiSignalProgrammer.h"
+#include "TypeCHdmiBuffer.h"
+#include "TypeCHdmiTranscoderProgrammer.h"
+
+// Experimental orchestration. The caller must validate the device, firmware
+// port mapping and signal preset; prepare pipe timings; hold display-core
+// power, the exclusive port and pipe leases, and a shared lock for all
+// register transactions. No MMIO backend or mode-setting hook is installed.
+class AlderLakeHdmiSequence {
+public:
+	AlderLakeHdmiSequence(const AlderLakeTypeCIO& io, TypeCPowerWell& well,
+		unsigned tcPort, unsigned pipe, unsigned attempts)
+		: fWell(well), fBackend(io, well, tcPort, attempts),
+		  fPower(fBackend.LifecycleOps()), fPll(io, tcPort, attempts),
+		  fTranscoder(io, pipe), fSignal(io, tcPort),
+		  fBuffer(io, tcPort, attempts), fPort(tcPort), fPipe(pipe), fStarted(false)
+	{
+	}
+
+	status_t Begin(uint32 pixelClockKHz, uint32 referenceKHz,
+		unsigned preset, bool loadgenWorkaround, bool positiveHSync,
+		bool positiveVSync, bool laneReversal)
+	{
+		if (fStarted || fPower.NeedsCleanup() || fPll.NeedsCleanup()
+			|| fTranscoder.NeedsCleanup() || fSignal.NeedsCleanup()
+			|| fBuffer.NeedsCleanup()) return B_BUSY;
+		if (fPort < 1 || fPort > 4 || fWell.Port() != fPort || fPipe > 2)
+			return B_BAD_VALUE;
+		DekelHdmiPllPlan pllPlan;
+		TypeCHdmiTranscoderPlan transPlan;
+		DekelHdmiSignalPlan signalPlan;
+		status_t status = BuildDekelHdmiPllPlan(pixelClockKHz, referenceKHz,
+			&pllPlan);
+		if (status != B_OK) return status;
+		status = BuildAlderLakeMobileTypeCHdmiPlan(fPort, 8, positiveHSync,
+			positiveVSync, &transPlan);
+		if (status != B_OK) return status;
+		status = BuildDekelHdmiSignalPlan(preset, pixelClockKHz,
+			loadgenWorkaround, &signalPlan);
+		if (status != B_OK) return status;
+
+		fStarted = true;
+		status = fPower.Acquire();
+		if (status != B_OK) return Fail(status);
+		status = fPll.Program(pllPlan);
+		if (status != B_OK) return Fail(status);
+		status = fTranscoder.Configure(transPlan);
+		if (status != B_OK) return Fail(status);
+		status = fTranscoder.Enable();
+		if (status != B_OK) return Fail(status);
+		status = fSignal.Apply(preset, pixelClockKHz, loadgenWorkaround);
+		if (status != B_OK) return Fail(status);
+		status = fBuffer.Enable(laneReversal);
+		if (status != B_OK) return Fail(status);
+		return B_OK;
+	}
+
+	status_t End()
+	{
+		if (!fStarted) return B_OK;
+		// Stop on cleanup failure so dependent power and clock resources
+		// stay held until the caller can retry the remaining cleanup.
+		status_t status = fBuffer.Release();
+		if (status != B_OK) return status;
+		status = fSignal.Restore();
+		if (status != B_OK) return status;
+		status = fTranscoder.Release();
+		if (status != B_OK) return status;
+		status = fPll.Release();
+		if (status != B_OK) return status;
+		status = fPower.Release();
+		if (status != B_OK) return status;
+		fStarted = false;
+		return B_OK;
+	}
+
+private:
+	status_t Fail(status_t cause)
+	{
+		status_t cleanup = End();
+		return cleanup == B_OK ? cause : cleanup;
+	}
+	AlderLakeHdmiSequence(const AlderLakeHdmiSequence&);
+	AlderLakeHdmiSequence& operator=(const AlderLakeHdmiSequence&);
+	TypeCPowerWell& fWell;
+	AlderLakeTypeCBackend fBackend;
+	TypeCPowerLifecycle fPower;
+	DekelHdmiPllProgrammer fPll;
+	TypeCHdmiTranscoderProgrammer fTranscoder;
+	DekelHdmiSignalProgrammer fSignal;
+	TypeCHdmiBuffer fBuffer;
+	unsigned fPort, fPipe;
+	bool fStarted;
+};
+
+#endif
diff --git a/src/add-ons/accelerants/intel_extreme/DekelHdmiPllProgrammer.h b/src/add-ons/accelerants/intel_extreme/DekelHdmiPllProgrammer.h
