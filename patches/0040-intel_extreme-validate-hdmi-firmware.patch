From 7fa61a5d6c1555c0b2336dffe50d5fe4f62a517e Mon Sep 17 00:00:00 2001
From: RenkuOS GPU Development <gpu-development@localhost>
Date: Fri, 6 Nov 2026 18:00:42 +0900
Subject: [PATCH] intel_extreme: validate Alder Lake HDMI firmware inputs

---
 .../intel_extreme/AlderLakeHdmiFirmware.h     | 76 +++++++++++++++++++
 1 file changed, 76 insertions(+)
 create mode 100644 src/add-ons/accelerants/intel_extreme/AlderLakeHdmiFirmware.h

diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiFirmware.h b/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiFirmware.h
new file mode 100644
index 00000000..0963f73c
--- /dev/null
+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiFirmware.h
@@ -0,0 +1,76 @@
+/*
