 #include "AlderLakeHdmiPowerPrerequisites.h"
 #include "DekelHdmiPllProgrammer.h"
 #include "DekelHdmiSignalProgrammer.h"
+#include "DekelHdmiLaneMode.h"
 #include "DisplayPipeLease.h"
 #include "TypeCHdmiBuffer.h"
 #include "TypeCHdmiClock.h"
@@ -30,7 +31,7 @@ public:
 		, fPower(fBackend.LifecycleOps(), true)
 		, fPll(io, tcPort, attempts)
 		, fClock(io, tcPort)
-		, fTranscoder(io, pipe)
+		, fLaneMode(io, tcPort), fTranscoder(io, pipe)
 		, fSignal(io, tcPort)
 		, fBuffer(io, tcPort, attempts)
 		, fPort(tcPort)
@@ -52,7 +53,7 @@ public:
 	{
 		fStage = "validation";
 		if (fStarted || fLease.IsHeld() || fPower.NeedsCleanup() || fPll.NeedsCleanup()
-			|| fClock.NeedsCleanup() || fTranscoder.NeedsCleanup() || fSignal.NeedsCleanup()
+			|| fClock.NeedsCleanup() || fLaneMode.NeedsCleanup() || fTranscoder.NeedsCleanup() || fSignal.NeedsCleanup()
 			|| fBuffer.NeedsCleanup())
 			return B_BUSY;
 		if ((dviCompatible && pixelClockKHz > 165000) || fPort < 1 || fPort > 4
@@ -126,6 +127,9 @@ public:
 			if (status != B_OK)
 				return Fail(status);
 		}
+		fStage = "legacy PHY lane mode";
+		status = fLaneMode.Apply();
+		if (status != B_OK) return Fail(status);
 		if (fPipeStage != NULL) {
 			fStage = "pipe timing";
 			status = fPipeStage->Prepare(*timing);
@@ -178,6 +182,8 @@ public:
 		status = fTranscoder.Release();
 		if (status != B_OK)
 			return status;
+		status = fLaneMode.Restore();
+		if (status != B_OK) return status;
 		if (fDisplayPower != NULL) {
 			status = fDisplayPower->ReleaseDdiIo();
 			if (status != B_OK)
@@ -234,6 +240,7 @@ private:
 	TypeCPowerLifecycle fPower;
 	DekelHdmiPllProgrammer fPll;
 	TypeCHdmiClock fClock;
+	DekelHdmiLaneMode fLaneMode;
 	TypeCHdmiTranscoderProgrammer fTranscoder;
 	DekelHdmiSignalProgrammer fSignal;
 	TypeCHdmiBuffer fBuffer;
