Date: Fri, 6 Nov 2026 17:31:52 +0900
Subject: [PATCH] intel_extreme: add bounded Type-C HDMI buffer control

---
 .../intel_extreme/TypeCHdmiBuffer.h           | 92 +++++++++++++++++++
 1 file changed, 92 insertions(+)
 create mode 100644 src/add-ons/accelerants/intel_extreme/TypeCHdmiBuffer.h

diff --git a/src/add-ons/accelerants/intel_extreme/TypeCHdmiBuffer.h b/src/add-ons/accelerants/intel_extreme/TypeCHdmiBuffer.h
new file mode 100644
index 00000000..af0a2828
--- /dev/null
+++ b/src/add-ons/accelerants/intel_extreme/TypeCHdmiBuffer.h
@@ -0,0 +1,92 @@
+/*
