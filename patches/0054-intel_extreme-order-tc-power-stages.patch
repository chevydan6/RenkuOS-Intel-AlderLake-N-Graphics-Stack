diff --git a/src/add-ons/accelerants/intel_extreme/TypeCPowerLifecycle.h b/src/add-ons/accelerants/intel_extreme/TypeCPowerLifecycle.h
index 715d617f..518792a5 100644
--- a/src/add-ons/accelerants/intel_extreme/TypeCPowerLifecycle.h
+++ b/src/add-ons/accelerants/intel_extreme/TypeCPowerLifecycle.h
@@ -25,8 +25,12 @@ struct TypeCPowerOps {
 
 class TypeCPowerLifecycle {
 public:
-	explicit TypeCPowerLifecycle(const TypeCPowerOps& ops)
-		: fOps(ops), fPowerHeld(false), fOwnershipTaken(false), fActive(false)
+	explicit TypeCPowerLifecycle(const TypeCPowerOps& ops, bool ownershipBeforePower = false)
+		: fOps(ops)
+		, fPowerHeld(false)
+		, fOwnershipTaken(false)
+		, fActive(false)
+		, fOwnershipBeforePower(ownershipBeforePower)
 	{
 	}
 
@@ -34,11 +38,13 @@ public:
 	{
 		if (fActive || fPowerHeld || fOwnershipTaken)
 			return B_BUSY;
-		if (fOps.acquirePower == NULL || fOps.releasePower == NULL
-			|| fOps.isOwned == NULL || fOps.setOwned == NULL
-			|| fOps.isReady == NULL)
+		if (fOps.acquirePower == NULL || fOps.releasePower == NULL || fOps.isOwned == NULL
+			|| fOps.setOwned == NULL || fOps.isReady == NULL)
 			return B_BAD_VALUE;
 
+		if (fOwnershipBeforePower)
+			return AcquireOwnershipFirst();
+
 		bool powerHeld = false;
 		status_t status = fOps.acquirePower(fOps.cookie, &powerHeld);
 		fPowerHeld = powerHeld;
@@ -72,6 +78,12 @@ public:
 	status_t Release()
 	{
 		fActive = false;
+		if (fOwnershipBeforePower && fPowerHeld) {
+			status_t status = fOps.releasePower(fOps.cookie);
+			if (status != B_OK)
+				return status;
+			fPowerHeld = false;
+		}
 		if (fOwnershipTaken) {
 			status_t status = fOps.setOwned(fOps.cookie, false);
 			if (status != B_OK)
@@ -87,9 +99,42 @@ public:
 		return B_OK;
 	}
 
-	bool NeedsCleanup() const { return fPowerHeld || fOwnershipTaken || fActive; }
+	bool NeedsCleanup() const
+	{
+		return fPowerHeld || fOwnershipTaken || fActive;
+	}
 
 private:
+	// ADL-P/N takes display ownership with parent power held, verifies TCSS
+	// readiness, then blocks TC cold through the AUX well and checks uC health.
+	status_t AcquireOwnershipFirst()
+	{
+		bool owned = false;
+		status_t status = fOps.isOwned(fOps.cookie, &owned);
+		if (status == B_OK && !owned) {
+			status = fOps.setOwned(fOps.cookie, true);
+			if (status == B_OK)
+				fOwnershipTaken = true;
+		}
+		bool ready = false;
+		if (status == B_OK)
+			status = fOps.isReady(fOps.cookie, &ready);
+		if (status == B_OK && !ready)
+			status = B_ERROR;
+		if (status == B_OK) {
+			bool held = false;
+			status = fOps.acquirePower(fOps.cookie, &held);
+			fPowerHeld = held;
+			if (status == B_OK && !held)
+				status = B_ERROR;
+		}
+		if (status != B_OK) {
+			status_t cleanup = Release();
+			return cleanup == B_OK ? status : cleanup;
+		}
+		fActive = true;
+		return B_OK;
+	}
 	TypeCPowerLifecycle(const TypeCPowerLifecycle&);
 	TypeCPowerLifecycle& operator=(const TypeCPowerLifecycle&);
 
@@ -97,6 +142,7 @@ private:
 	bool fPowerHeld;
 	bool fOwnershipTaken;
 	bool fActive;
+	bool fOwnershipBeforePower;
 };
 
 #endif
