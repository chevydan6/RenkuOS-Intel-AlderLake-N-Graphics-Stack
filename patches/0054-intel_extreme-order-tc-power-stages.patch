From 2072dbe3270da56a719d7430008b65b602788d62 Mon Sep 17 00:00:00 2001
From: chevydan6 <339888127+chevydan6@users.noreply.github.com>
Date: Fri, 6 Nov 2026 19:23:12 +0900
Subject: [PATCH] intel_extreme: order TC ownership before AUX and DDI IO

---
 .../intel_extreme/AlderLakeDisplayPower.h     |  75 ++++++--
 .../intel_extreme/AlderLakeHdmiSequence.h     | 181 +++++++++++-------
 .../intel_extreme/TypeCPowerLifecycle.h       |  58 +++++-
 3 files changed, 222 insertions(+), 92 deletions(-)

diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeDisplayPower.h b/src/add-ons/accelerants/intel_extreme/AlderLakeDisplayPower.h
index e759d44d..77d49967 100644
--- a/src/add-ons/accelerants/intel_extreme/AlderLakeDisplayPower.h
+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeDisplayPower.h
@@ -23,6 +23,14 @@ public:
 	{
 	}
 	status_t Acquire()
+	{
+		status_t status = AcquireParents();
+		if (status != B_OK)
+			return status;
+		status = AcquireDdiIo();
+		return status == B_OK ? status : Fail(status);
+	}
+	status_t AcquireParents()
 	{
 		if (fAcquired)
 			return B_BUSY;
@@ -30,27 +38,60 @@ public:
 			|| !fIO.read || !fIO.write || !fIO.pause)
 			return B_BAD_VALUE;
 		uint32 dc;
-		status_t s = Read(0x45504, &dc);
-		if (s != B_OK)
-			return s;
+		status_t status = Read(0x45504, &dc);
+		if (status != B_OK)
+			return status;
 		if (dc & 0x2000000bU)
 			return B_BUSY;
-		for (unsigned stage = 0; stage < 4; stage++) {
+		status = AcquireUntil(3);
+		return status == B_OK ? status : Fail(status);
+	}
+	// After PHY ownership, PLL and port clock. On failure leave all held
+	// references intact so the sequence can disable consumers before release.
+	status_t AcquireDdiIo()
+	{
+		return fAcquired == 3 ? AcquireUntil(4) : B_BAD_VALUE;
+	}
+	status_t ReleaseDdiIo()
+	{
+		return ReleaseUntil(3);
+	}
+	status_t Release()
+	{
+		return ReleaseUntil(0);
+	}
+	unsigned Port() const
+	{
+		return fPort;
+	}
+	unsigned PipeIndex() const
+	{
+		return fPipe;
+	}
+	bool NeedsCleanup() const
+	{
+		return fAcquired != 0;
+	}
+
+private:
+	status_t AcquireUntil(unsigned target)
+	{
+		for (unsigned stage = fAcquired; stage < target; stage++) {
 			unsigned slot = Slot(stage);
 			uint32 bit = 1U << slot;
 			if (fReferences[slot] == 0xffffffffU || (!fReferences[slot] && (*fOwned & bit)))
-				return Fail(B_BUSY);
+				return B_BUSY;
 			uint32 value;
-			s = Read(Register(slot), &value);
+			status_t s = Read(Register(slot), &value);
 			if (s != B_OK)
-				return Fail(s);
+				return s;
 			uint32 request = Request(slot), state = request >> 1;
 			// Parent state must already be on; request pins it for this lifetime.
 			if (slot < 5 && !(value & state))
-				return Fail(B_BUSY);
+				return B_BUSY;
 			if (fReferences[slot]) {
 				if ((value & (request | state)) != (request | state))
-					return Fail(B_ERROR);
+					return B_ERROR;
 				fReferences[slot]++;
 				fAcquired++;
 				continue;
@@ -58,20 +99,20 @@ public:
 			if (!(value & request)) {
 				s = fIO.write(fIO.cookie, Register(slot), value | request);
 				if (s != B_OK)
-					return Fail(s);
+					return s;
 				*fOwned |= bit;
 			}
 			fReferences[slot] = 1;
 			fAcquired++;
 			s = Wait(slot, true);
 			if (s != B_OK)
-				return Fail(s);
+				return s;
 		}
 		return B_OK;
 	}
-	status_t Release()
+	status_t ReleaseUntil(unsigned target)
 	{
-		while (fAcquired) {
+		while (fAcquired > target) {
 			unsigned slot = Slot(fAcquired - 1);
 			uint32 bit = 1U << slot;
 			if (!fReferences[slot])
@@ -99,14 +140,6 @@ public:
 		}
 		return B_OK;
 	}
-	unsigned Port() const { return fPort; }
-	unsigned PipeIndex() const { return fPipe; }
-	bool NeedsCleanup() const
-	{
-		return fAcquired != 0;
-	}
-
-private:
 	unsigned Slot(unsigned stage) const
 	{
 		return stage < 2 ? stage : stage == 2 ? 2 + fPipe : 4 + fPort;
