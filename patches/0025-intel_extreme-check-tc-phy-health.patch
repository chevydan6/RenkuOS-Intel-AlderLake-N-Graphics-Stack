From 0cfafa7edbec86de6d025c155eb6b38078520ba6 Mon Sep 17 00:00:00 2001
From: RenkuOS GPU Development <gpu-development@localhost>
Date: Fri, 6 Nov 2026 17:20:42 +0900
Subject: [PATCH] intel_extreme: check Type-C PHY health before ownership

---
 .../intel_extreme/AlderLakeTypeCBackend.h     | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCBackend.h b/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCBackend.h
index 6686a1a9..42798d46 100644
--- a/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCBackend.h
+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCBackend.h
@@ -43,6 +43,7 @@ private:
 
 	uint32 BufferOffset() const { return 0x64300U + (fPort - 1) * 0x100U; }
 	uint32 StatusOffset() const { return 0x161500U + (fPort - 1) * 4U; }
+	uint32 PhyHealthOffset() const { return 0x16836cU + (fPort - 1) * 0x1000U; }
 
 	status_t Read(uint32 offset, uint32* value)
 	{
@@ -54,6 +55,26 @@ private:
 		return status;
 	}
 
+	status_t CheckPhyHealth()
+	{
+		// Ports 1-4 share HIP index register 0. Serialization must cover
+		// selecting the bank and reading the aperture as one operation.
+		const uint32 index = 2U << ((fPort - 1) * 8);
+		for (unsigned i = 0; i < fAttempts; i++) {
+			status_t status = fIO.write(fIO.cookie, 0x1010a0U, index);
+			if (status != B_OK)
+				return status;
+			uint32 value;
+			status = Read(PhyHealthOffset(), &value);
+			if (status != B_OK)
+				return status;
+			if ((value & (1U << 15)) != 0)
+				return B_OK;
+			fIO.pause(fIO.cookie);
+		}
+		return B_TIMED_OUT;
+	}
+
 	static status_t AcquirePower(void* cookie, bool* held)
 	{
 		AlderLakeTypeCBackend& self = *(AlderLakeTypeCBackend*)cookie;
@@ -62,6 +83,15 @@ private:
 		bool wasHeld = self.fWell.IsHeld();
 		status_t status = self.fWell.Acquire();
 		*held = status == B_OK || (!wasHeld && self.fWell.IsHeld());
+		if (status == B_OK) {
+			status = self.CheckPhyHealth();
+			if (status != B_OK) {
+				status_t cleanup = self.fWell.Release();
+				*held = cleanup != B_OK;
+				if (cleanup != B_OK)
+					return cleanup;
+			}
+		}
 		return status;
 	}
 
