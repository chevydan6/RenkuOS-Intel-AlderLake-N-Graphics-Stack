+static status_t
+release_msi(intel_info& info)
+{
+	// Configuration owns the vectors independently of MSI enablement.
+	// Never return a potentially enabled vector to the allocator.
+	if (info.use_msi) {
+		status_t status = gPCI->disable_msi(info.pci->bus,
+			info.pci->device, info.pci->function);
+		if (status != B_OK)
+			return status;
+		info.use_msi = false;
+	}
+	if (info.msi_configured) {
+		status_t status = gPCI->unconfigure_msi(info.pci->bus,
+			info.pci->device, info.pci->function);
+		if (status != B_OK)
+			return status;
+		info.msi_configured = false;
+	}
+	return B_OK;
+}
