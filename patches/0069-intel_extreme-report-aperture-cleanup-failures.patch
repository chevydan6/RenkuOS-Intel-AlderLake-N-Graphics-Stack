@@ -580,6 +580,19 @@ init_interrupt_handler(intel_info &info)
 //	#pragma mark -
 
 
+static void
+release_aperture(intel_info& info)
+{
+	status_t status = gGART->unmap_aperture(info.aperture);
+	if (status < B_OK) {
+		// GART retains the aperture and its backing on teardown failure.
+		// Do not bypass its ownership or retry by freeing backing here.
+		ERROR("failed to release GART aperture %" B_PRId32
+			": %s; retained by GART\n", info.aperture, strerror(status));
+	}
+}
+
+
 status_t
 intel_free_memory(intel_info &info, addr_t base)
 {
@@ -616,7 +629,7 @@ intel_extreme_init(intel_info &info)
 		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA | B_CLONEABLE_AREA);
 	if (info.shared_area < B_OK) {
 		ERROR("error: could not create shared area!\n");
-		gGART->unmap_aperture(info.aperture);
+		release_aperture(info);
 		return info.shared_area;
 	}
 
@@ -656,7 +669,7 @@ intel_extreme_init(intel_info &info)
 		(void**)&info.registers);
 	if (mmioMapper.InitCheck() < B_OK) {
 		ERROR("error: could not map memory I/O!\n");
-		gGART->unmap_aperture(info.aperture);
+		release_aperture(info);
 		return info.registers_area;
 	}
 
@@ -977,7 +990,7 @@ intel_extreme_uninit(intel_info &info)
 		}
 	}
 
-	gGART->unmap_aperture(info.aperture);
+	release_aperture(info);
 
 	delete_area(info.registers_area);
 	delete_area(info.shared_area);
