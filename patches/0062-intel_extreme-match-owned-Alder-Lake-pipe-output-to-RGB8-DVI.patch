From 4f981b859015d96ad4ace6b9934a69df48bde703 Mon Sep 17 00:00:00 2001
From: chevydan6 <339888127+chevydan6@users.noreply.github.com>
Date: Fri, 6 Nov 2026 20:19:41 +0900
Subject: [PATCH] intel_extreme: match owned Alder Lake pipe output to RGB8 DVI

Actual N100 inventory found inactive pipe B retained PIPE_MISC BPC value 4 (12bpc) while the opt-in DVI transcoder was configured for 8bpc. Set the documented BPC, RGB and dithering fields before enabling the owned pipe, validate readback, and restore only those saved fields after disabling it. Preserve unrelated firmware bits and constrain the adapter to the selected pipe and documented mask. This corrects a measured configuration mismatch; desktop scanout remains pending physical verification.
---
 .../intel_extreme/AlderLakeHdmiPipe.h         | 48 +++++++++++++++++--
 .../intel_extreme/AlderLakeTypeCMmio.h        |  9 +++-
 2 files changed, 53 insertions(+), 4 deletions(-)

diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiPipe.h b/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiPipe.h
index f6f2ca5d..5f7d0981 100644
--- a/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiPipe.h
+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiPipe.h
@@ -10,7 +10,7 @@ struct AlderLakeHdmiTiming {
 // Injected-I/O pipe stage. Caller owns the pipe, power domains and global
 // modesetting lock. Refuses active firmware pipes; never disables an unowned
 // pipe. Transcoder function and port clocks must precede Enable(), while the
-// DDI buffer must be disabled before Release(). No live modesetting hook.
+// DDI buffer must be disabled before Release(). PIPE_MISC must agree with the RGB8 DVI transcoder.
 class AlderLakeHdmiPipe {
 public:
 	AlderLakeHdmiPipe(const AlderLakeTypeCIO& io, unsigned pipe, unsigned attempts)
@@ -18,6 +18,8 @@ public:
 		, fPipe(pipe)
 		, fAttempts(attempts)
 		, fSavedControl(0)
+		, fSavedMisc(0)
+		, fMiscWritten(false)
 		, fWritten(0)
 		, fPrepared(false)
 		, fEnabled(false)
@@ -36,6 +38,9 @@ public:
 			return s;
 		if (fSavedControl & 0xc0000000U)
 			return B_BUSY;
+		s = Read(Misc(), &fSavedMisc);
+		if (s != B_OK)
+			return s;
 		for (unsigned i = 0; i < 6; i++) {
 			s = Read(Timing(i), &fSaved[i]);
 			if (s != B_OK)
@@ -50,6 +55,18 @@ public:
 				return Fail(s);
 			fWritten++;
 		}
+		// PIPE_MISC BPC is independent of TRANS_DDI_FUNC_CTL. ADLP value
+		// 4 in bits 7:5 means 12bpc, not 8bpc. Set RGB, 8bpc and no
+		// dithering before enabling the owned inactive pipe. Linux
+		// intel_display_regs.h PIPE_MISC documents these exact fields.
+		s = fIO.write(fIO.cookie, Misc(), fSavedMisc & ~MiscMask());
+		if (s != B_OK)
+			return Fail(s);
+		fMiscWritten = true;
+		uint32 misc;
+		s = Read(Misc(), &misc);
+		if (s != B_OK || (misc & MiscMask()) != 0)
+			return Fail(s != B_OK ? s : B_ERROR);
 		s = fIO.write(fIO.cookie, Control(), fSavedControl & ~(7U << 21));
 		if (s != B_OK)
 			return Fail(s);
@@ -84,6 +101,20 @@ public:
 				return s;
 			fPrepared = false;
 		}
+		if (fMiscWritten) {
+			uint32 misc;
+			status_t s = Read(Misc(), &misc);
+			if (s != B_OK)
+				return s;
+			s = fIO.write(fIO.cookie, Misc(),
+				(misc & ~MiscMask()) | (fSavedMisc & MiscMask()));
+			if (s != B_OK)
+				return s;
+			s = Read(Misc(), &misc);
+			if (s != B_OK || (misc & MiscMask()) != (fSavedMisc & MiscMask()))
+				return s != B_OK ? s : B_ERROR;
+			fMiscWritten = false;
+		}
 		while (fWritten) {
 			unsigned i = fWritten - 1;
 			status_t s = fIO.write(fIO.cookie, Timing(i), fSaved[i]);
@@ -99,7 +130,7 @@ public:
 	}
 	bool NeedsCleanup() const
 	{
-		return fPrepared || fEnabled || fWritten;
+		return fPrepared || fEnabled || fWritten || fMiscWritten;
 	}
 
 private:
@@ -115,6 +146,16 @@ private:
 	{
 		return 0x60000U + fPipe * 0x1000U + i * 4;
 	}
+	static uint32 MiscMask()
+	{
+		// YUV420 enable/full blend, output YUV, BPC, dither enable/type.
+		// Preserve all other fields, including inherited firmware bit24.
+		return (3U << 26) | (1U << 11) | (7U << 5) | (7U << 2);
+	}
+	uint32 Misc() const
+	{
+		return 0x70030U + fPipe * 0x1000U;
+	}
 	uint32 Control() const
 	{
 		return 0x70008U + fPipe * 0x1000U;
@@ -146,7 +187,8 @@ private:
 	AlderLakeHdmiPipe& operator=(const AlderLakeHdmiPipe&);
 	AlderLakeTypeCIO fIO;
 	unsigned fPipe, fAttempts;
-	uint32 fSavedControl, fSaved[6];
+	uint32 fSavedControl, fSaved[6], fSavedMisc;
+	bool fMiscWritten;
 	unsigned fWritten;
 	bool fPrepared, fEnabled;
 };
diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCMmio.h b/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCMmio.h
index 547a56c3..e57dde06 100644
--- a/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCMmio.h
+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeTypeCMmio.h
@@ -60,7 +60,8 @@ private:
 		if (!Valid(offset)) return false;
 		if ((offset >= 0x60000U + fPipe * 0x1000U
 			&& offset <= 0x60014U + fPipe * 0x1000U)
-			|| offset == 0x70008U + fPipe * 0x1000U)
+			|| offset == 0x70008U + fPipe * 0x1000U
+			|| offset == 0x70030U + fPipe * 0x1000U)
 			return true;
 		const uint32 plane = 0x70000U + fPipe * 0x1000U;
 		if (offset == plane + 0x180U || offset == plane + 0x1ccU
@@ -101,6 +102,12 @@ private:
 	{
 		AlderLakeTypeCMmio& self = *(AlderLakeTypeCMmio*)cookie;
 		if (!self.Allowed(offset, true)) return B_BAD_VALUE;
+		if (offset == 0x70030U + self.fPipe * 0x1000U) {
+			const uint32 mask = (3U << 26) | (1U << 11) | (7U << 5) | (7U << 2);
+			uint32 current = *(volatile uint32*)(self.fBase + offset);
+			if (current == 0xffffffffU || ((current ^ value) & ~mask) != 0)
+				return B_BAD_VALUE;
+		}
 		if (offset == 0x45404U || offset == 0x45454U) {
 			const uint32 allowed = offset == 0x45404U
 				? 2U | (2U << 2) | (2U << (2 * (self.fPipe + 5)))
-- 
2.43.0

