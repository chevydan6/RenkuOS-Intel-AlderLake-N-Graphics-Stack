@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: MIT
+#ifndef INTEL_N100_RESET_SAFETY_H
+#define INTEL_N100_RESET_SAFETY_H
+#include "IntelN100PciPower.h"
+// Retained evidence from the existing reset safety checks. No extra MMIO,
+// cleanup or retry is performed to collect this report.
+struct IntelN100ResetSafety {
+	enum Reason : uint32_t { None, Clock, Deadline, PciCapture, PciChanged,
+		Mapping, Owner, GroupLedger, DomainLedger, AckRead, AckState };
+	uint32_t reason, checks, phase, domain, ackReads, pciResult;
+	uint32_t groupStage, groupCount, ack[5];
+	uint64_t now, previous, deadline;
+	IntelN100PciSnapshot expected, observed;
+};
+#endif
