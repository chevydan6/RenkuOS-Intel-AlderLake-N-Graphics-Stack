 static bool
+ResetOwnerPower(GroupContext& context)
+{
+	HandshakeContext& h = *context.handshake;
+	IntelN100ResetSafety& s = context.safety;
+	s.expected = h.original;
+	s.observed = {};
+	s.pciResult = IntelN100PciPower::Capture(ReadConfig, &h.device,
+		h.device.base, h.device.size, s.observed);
+	if (s.pciResult != IntelN100PciPower::Success) {
+		s.reason = IntelN100ResetSafety::PciCapture;
+		return false;
+	}
+	if (!IntelN100PciPower::Same(h.original, s.observed)) {
+		s.reason = IntelN100ResetSafety::PciChanged;
+		return false;
+	}
+	mutex_lock(&sLock);
+	bool mapping = sObservationPhase == ObservationHandshaking
+		&& sObservationLease == h.lease && sRegistersUncached
+		&& sResources.registers == h.registers;
+	bool owner = sState.DiagnosticAllowed();
+	mutex_unlock(&sLock);
+	if (!mapping || !owner) {
+		s.reason = !mapping ? IntelN100ResetSafety::Mapping : IntelN100ResetSafety::Owner;
+		return false;
+	}
+	return true;
+}
