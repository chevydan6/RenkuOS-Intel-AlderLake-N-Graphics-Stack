diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeDisplayRegisters.h b/src/add-ons/accelerants/intel_extreme/AlderLakeDisplayRegisters.h
new file mode 100644
index 00000000..ee0ed14c
--- /dev/null
+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeDisplayRegisters.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef INTEL_EXTREME_ALDER_LAKE_DISPLAY_REGISTERS_H
+#define INTEL_EXTREME_ALDER_LAKE_DISPLAY_REGISTERS_H
+
+#include <SupportDefs.h>
+
+// Physical BAR offsets for the verified display-version-13 path. These are
+// not the register-block-tagged offsets used by the inherited read32 API.
+// Callers still validate the mapped BAR, power state, port and pipe indices.
+// Reference: Intel display PRMs and i915 intel_display_regs.h. Type-C bases
+// refer to TC1; per-port strides remain explicit at their call sites.
+namespace AlderLakeRegisters {
+enum : uint32 {
+	kMainPowerDriver = 0x00045404U,
+	kAuxPowerDriver = 0x00045444U,
+	kDdiPowerDriver = 0x00045454U,
+	kDcStateEnable = 0x00045504U,
+	kTypeCStatusBase = 0x00161500U,
+	kTypeCBufferControlBase = 0x00064300U,
+	kDekelHealthBase = 0x0016836cU,
+	kHipIndex0 = 0x001010a0U,
+	kPipeControlBase = 0x00070008U,
+	kPipeMiscBase = 0x00070030U,
+	kPipeTimingBase = 0x00060000U,
+	kPrimaryPlaneControlBase = 0x00070180U,
+	kCursorControlBase = 0x00070080U,
+};
+}
+
+#endif
