+// Private synchronous entries; all associations are protected by sModulesLock.
+// Frames are stack scoped; allocation failure precedes lookup or ref mutation.
+struct module_entry {
+ module_entry* next;
+ thread_id thread;
+ const char* path;
+ unsigned long long identity;
+};
+static module_entry* sModuleEntries;
+static unsigned long long sModuleEntryIdentity;
+
+static module_entry*
+current_module_entry()
+{
+ for (module_entry* entry = sModuleEntries; entry != NULL; entry = entry->next) {
+  if (entry->thread == thread_get_current_thread_id())
+   return entry;
+ }
+ return NULL;
+}
+
+class ModuleEntryScope {
+public:
+ explicit ModuleEntryScope(const char* path) : fEntry(NULL), fStatus(B_OK)
+ {
+  if (path == NULL) { fStatus = B_BAD_VALUE; return; }
+  thread_id thread = thread_get_current_thread_id();
+  for (module_entry* entry = sModuleEntries; entry != NULL; entry = entry->next) {
+   if (entry->thread == thread && strcmp(entry->path, path) == 0) {
+    fStatus = B_BUSY; return;
+   }
+  }
+  if (sModuleEntryIdentity == ~0ULL) { fStatus = B_BUSY; return; }
+  fEntry = (module_entry*)calloc(1, sizeof(module_entry));
+  if (fEntry == NULL) { fStatus = B_NO_MEMORY; return; }
+  fEntry->thread = thread;
+  fEntry->path = path;
+  fEntry->identity = ++sModuleEntryIdentity;
+  fEntry->next = sModuleEntries;
+  sModuleEntries = fEntry;
+ }
+ ~ModuleEntryScope()
+ {
+  if (fEntry == NULL) return;
+  module_entry** link = &sModuleEntries;
+  while (*link != NULL && *link != fEntry) link = &(*link)->next;
+  if (*link == fEntry) *link = fEntry->next;
+  free(fEntry);
+ }
+ status_t Status() const { return fStatus; }
+private:
+ ModuleEntryScope(const ModuleEntryScope&);
+ ModuleEntryScope& operator=(const ModuleEntryScope&);
+ module_entry* fEntry;
+ status_t fStatus;
+};
+
