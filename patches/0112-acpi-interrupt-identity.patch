+enum ACPIInterruptPhase { IRQEmpty, IRQInstalling, IRQInstalled, IRQRemoving,
+ IRQUncertain };
+struct ACPIInterruptRecord {
+ ACPI_OSD_HANDLER handler;
+ void* context;
+ ACPIInterruptPhase phase;
+};
+static ACPIInterruptRecord sInterrupts[NUM_IO_VECTORS];
+static spinlock sInterruptLock = B_SPINLOCK_INITIALIZER;
+#endif
 
 
