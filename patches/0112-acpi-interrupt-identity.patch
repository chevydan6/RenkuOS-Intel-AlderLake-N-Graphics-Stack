@@ -795,23 +807,37 @@
 AcpiOsInstallInterruptHandler(UINT32 interruptNumber,
 		ACPI_OSD_HANDLER serviceRoutine, void *context)
 {
-	status_t result;
-	DEBUG_FUNCTION_F("vector: %" B_PRIu32 "; handler: %p context %p",
-		(uint32)interruptNumber, serviceRoutine, context);
-
-#ifdef _KERNEL_MODE
-	// It so happens that the Haiku and ACPI-CA interrupt handler routines
-	// return the same values with the same meanings
-	sInterruptHandlerData[interruptNumber] = context;
-	result = install_io_interrupt_handler(interruptNumber,
-		(interrupt_handler)serviceRoutine, context, 0);
-
-	DEBUG_FUNCTION_F("vector: %" B_PRIu32 "; handler: %p context %p returned %" B_PRId32,
-		(uint32)interruptNumber, serviceRoutine, context, (uint32)result);
-
-	return result == B_OK ? AE_OK : AE_BAD_PARAMETER;
-#else
-	return AE_BAD_PARAMETER;
+#ifdef _KERNEL_MODE
+ if (interruptNumber >= NUM_IO_VECTORS || serviceRoutine == NULL)
+  return AE_BAD_PARAMETER;
+ cpu_status irq = disable_interrupts();
+ acquire_spinlock(&sInterruptLock);
+ ACPIInterruptRecord& record = sInterrupts[interruptNumber];
+ if (record.phase != IRQEmpty) {
+  release_spinlock(&sInterruptLock);
+  restore_interrupts(irq);
+  return AE_ERROR;
+ }
+ record.handler = serviceRoutine;
+ record.context = context;
+ record.phase = IRQInstalling;
+ release_spinlock(&sInterruptLock);
+ restore_interrupts(irq);
+ status_t result = install_io_interrupt_handler(interruptNumber,
+  (interrupt_handler)serviceRoutine, context, 0);
+ irq = disable_interrupts();
+ acquire_spinlock(&sInterruptLock);
