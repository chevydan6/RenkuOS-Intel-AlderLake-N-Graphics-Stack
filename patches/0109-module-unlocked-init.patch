+static status_t
+get_dependent_modules(struct module* module, const module_transition& ticket)
+{
+	module_image* image = module->module_image;
+	if (image == NULL || image->dependencies == NULL)
+		return B_OK;
+	if (image->dependency_state == DependenciesComplete) {
+		if (image->dependency_leases == 0x7fffffff)
+			return B_BUSY;
+		image->dependency_leases++;
+		return B_OK;
+	}
+	if (image->dependency_state != DependenciesEmpty)
+		return B_BUSY;
+
+	image->dependency_state = DependenciesBuilding;
+	module_dependency* dependencies = image->dependencies;
+	size_t count = 0;
+	while (dependencies[count].name != NULL)
+		count++;
+	image->dependency_count = count;
+	if (count != 0) {
+		image->dependency_records = (module_info**)calloc(count,
+			sizeof(module_info*));
+		if (image->dependency_records == NULL) {
+			image->dependency_state = DependenciesQuarantined;
+			return B_NO_MEMORY;
+		}
+	}
+	for (size_t i = 0; i < count; i++) {
+		recursive_lock_unlock(&sModulesLock);
+		status_t status = get_module(dependencies[i].name,
+			&image->dependency_records[i]);
+		recursive_lock_lock(&sModulesLock);
+		// Account for successful child custody even if the parent is stale.
+		if (status >= B_OK)
+			image->dependency_acquired++;
+		if (!validate_module_transition(ticket)) {
+			image->dependency_state = DependenciesQuarantined;
+			return B_ERROR;
+		}
+		if (status < B_OK) {
+			// The acquired prefix remains owned, unpublished and non-replayable.
+			image->dependency_records[i] = NULL;
+			image->dependency_state = DependenciesQuarantined;
+			return status;
+		}
+	}
+	if (!validate_module_transition(ticket))
+		return B_ERROR;
+	for (size_t i = 0; i < count; i++)
+		*dependencies[i].info = image->dependency_records[i];
+	image->dependency_leases = 1;
+	image->dependency_state = DependenciesComplete;
+	return B_OK;
+}
