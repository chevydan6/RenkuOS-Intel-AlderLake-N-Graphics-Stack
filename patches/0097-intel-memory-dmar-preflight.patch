+// All callbacks and module operations occur outside sLock. The resident
+// request pin excludes reuse; display closure invalidates completion admission.
+static status_t
+PreflightDMAR(intel_memory_preflight_report* output)
+{
+ if (output == NULL)
+  return B_BAD_VALUE;
+ mutex_lock(&sLock);
+ if (sPreflightActive || sPreflightUncertain || sObservationBlocked
+  || sObservationPhase != ObservationIdle) {
+  mutex_unlock(&sLock);
+  return B_BUSY;
+ }
+ status_t status = Status(sState.AcquireRequest(sPreflightLease));
+ if (status != B_OK) {
+  mutex_unlock(&sLock);
+  return status;
+ }
+ status = Status(sState.BeginOperation(sPreflightLease,
+  IntelApertureLeaseState::Query, sPreflightPin));
+ if (status != B_OK) {
+  sState.Release(sPreflightLease);
+  sPreflightLease = 0;
+  mutex_unlock(&sLock);
+  return status;
+ }
+ sPreflightActive = true;
+ const uint64 lease = sPreflightLease;
+ sPreflightReport = {};
+ sPreflightReport.classification = ACPI_DMAR_NOT_READY;
+ acpi_dmar_descriptor_module_info* provider = sDMARProvider;
+ mutex_unlock(&sLock);
+
+ status_t dependency = B_OK;
+ if (provider == NULL)
+  dependency = get_module(ACPI_DMAR_DESCRIPTOR_MODULE_NAME,
+   (module_info**)&provider);
+ // Record custody before invoking provider code, including on close overlap.
+ mutex_lock(&sLock);
+ if (dependency == B_OK)
+  sDMARProvider = provider;
+ mutex_unlock(&sLock);
+ uint32 acpica = 0;
+ acpi_dmar_descriptor_result classification = ACPI_DMAR_NOT_READY;
+ if (dependency == B_OK)
+  classification = provider->classify(&acpica);
+
+ mutex_lock(&sLock);
+ sPreflightReport.dependency_status = dependency;
+ sPreflightReport.classification = classification;
+ sPreflightReport.acpica_status = acpica;
+ // No descriptor outcome establishes immutable bytes or reserved policy.
+ sPreflightReport.configured = false;
+ bool current = sPreflightActive && sPreflightLease == lease
+  && sState.DiagnosticAllowed();
+ sPreflightReport.completed = current;
+ *output = sPreflightReport;
+ if (!current) {
+  // Retain request, operation pin, provider and all backing on uncertainty.
+  sPreflightUncertain = true;
+  mutex_unlock(&sLock);
+  return B_BUSY;
+ }
+ sState.Release(sPreflightLease);
+ sState.EndOperation(sPreflightPin, false);
+ sPreflightLease = 0;
+ sPreflightActive = false;
+ mutex_unlock(&sLock);
+ return dependency == B_OK ? B_ERROR : dependency;
+}
