+#ifndef INTEL_EXTREME_TYPE_C_POWER_LIFECYCLE_H
+#define INTEL_EXTREME_TYPE_C_POWER_LIFECYCLE_H
+
+#include <SupportDefs.h>
+#include <stddef.h>
+
+// The platform backend supplies the actual power-well, readiness and PHY
+// operations. Calls on one lifecycle and its backend must be serialized by
+// the caller, including against other users of the shared power domain. Each
+// mutating callback must either succeed or leave its resource unchanged.
+struct TypeCPowerOps {
+	void* cookie;
+	status_t (*acquirePower)(void* cookie);
+	status_t (*releasePower)(void* cookie);
+	status_t (*isOwned)(void* cookie, bool* owned);
+	status_t (*setOwned)(void* cookie, bool owned);
+	status_t (*isReady)(void* cookie, bool* ready);
+};
+
+class TypeCPowerLifecycle {
+public:
+	explicit TypeCPowerLifecycle(const TypeCPowerOps& ops)
+		: fOps(ops), fPowerHeld(false), fOwnershipTaken(false), fActive(false)
+	{
+	}
+
+	status_t Acquire()
+	{
+		if (fActive || fPowerHeld || fOwnershipTaken)
+			return B_BUSY;
+		if (fOps.acquirePower == NULL || fOps.releasePower == NULL
+			|| fOps.isOwned == NULL || fOps.setOwned == NULL
+			|| fOps.isReady == NULL)
+			return B_BAD_VALUE;
+
+		status_t status = fOps.acquirePower(fOps.cookie);
+		if (status != B_OK)
+			return status;
+		fPowerHeld = true;
+
+		bool owned = false;
+		status = fOps.isOwned(fOps.cookie, &owned);
+		if (status == B_OK && !owned) {
+			status = fOps.setOwned(fOps.cookie, true);
+			if (status == B_OK)
+				fOwnershipTaken = true;
+		}
+
+		bool ready = false;
+		if (status == B_OK)
+			status = fOps.isReady(fOps.cookie, &ready);
+		if (status == B_OK && !ready)
+			status = B_ERROR;
+		if (status != B_OK) {
+			status_t cleanup = Release();
+			return cleanup == B_OK ? status : cleanup;
+		}
+
+		fActive = true;
+		return B_OK;
+	}
+
+	status_t Release()
+	{
+		fActive = false;
+		if (fOwnershipTaken) {
+			status_t status = fOps.setOwned(fOps.cookie, false);
+			if (status != B_OK)
+				return status;
+			fOwnershipTaken = false;
+		}
+		if (fPowerHeld) {
+			status_t status = fOps.releasePower(fOps.cookie);
+			if (status != B_OK)
+				return status;
+			fPowerHeld = false;
+		}
+		return B_OK;
+	}
+
+private:
+	TypeCPowerLifecycle(const TypeCPowerLifecycle&);
+	TypeCPowerLifecycle& operator=(const TypeCPowerLifecycle&);
+
+	TypeCPowerOps fOps;
+	bool fPowerHeld;
+	bool fOwnershipTaken;
+	bool fActive;
+};
+
+#endif
