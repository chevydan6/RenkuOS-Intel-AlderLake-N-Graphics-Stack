 //	#pragma mark - ACPI bus manager API
 
 
+// Retained lifecycle evidence is image-owned; module-manager custody backs it.
+// Serialized by the existing module lifecycle lock. No cessation is inferred.
+enum ACPILifecyclePhase { ACPIUnused, ACPIStarting, ACPIReady, ACPIRetained };
+static ACPILifecyclePhase sACPILifecycle = ACPIUnused;
+static uint32 sACPIAttempted = 0;
+static uint32 sACPICompleted = 0;
+static ACPI_STATUS sACPIFailure = AE_OK;
+static status_t sACPIDPCFailure = B_OK;
+static uint32 sACPINonfatalAttempted = 0;
+static uint32 sACPINonfatalCompleted = 0;
+static ACPI_STATUS sACPINonfatalFailure = AE_OK;
+
+static bool
+acpi_stage_failed(uint32 stage, ACPI_STATUS status, const char* message)
+{
+	if (checkAndLogFailure(status, message)) {
+		sACPIFailure = status;
+		return true;
+	}
+	sACPICompleted |= stage;
+	return false;
+}
+
+static status_t
+acpi_retain_lifecycle()
+{
+	sACPILifecycle = ACPIRetained;
+	// Producers are not callbacks. Closing admission neither joins nor waits.
+	acpi_close_dpc_admission();
+	return B_ERROR;
+}
