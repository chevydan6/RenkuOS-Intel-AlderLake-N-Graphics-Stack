+static bool
+ReadGtAck(addr_t address, uint32& value)
+{
+	// N100 x86-64 only: explicit UC, aligned volatile 32-bit load and read
+	// barriers (LFENCE). This is not a future GT write/posting protocol.
+	memory_read_barrier();
+	value = *(const volatile uint32*)address;
+	memory_read_barrier();
+	return value != UINT32_MAX;
+}
