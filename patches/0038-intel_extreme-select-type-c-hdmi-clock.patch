 	TypeCHdmiBuffer fBuffer;
diff --git a/src/add-ons/accelerants/intel_extreme/TypeCHdmiClock.h b/src/add-ons/accelerants/intel_extreme/TypeCHdmiClock.h
new file mode 100644
index 00000000..641419f0
--- /dev/null
+++ b/src/add-ons/accelerants/intel_extreme/TypeCHdmiClock.h
@@ -0,0 +1,103 @@
