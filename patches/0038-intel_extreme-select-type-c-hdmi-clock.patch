+ * Distributed under the terms of the MIT License.
+ */
+#ifndef INTEL_EXTREME_TYPE_C_HDMI_CLOCK_H
+#define INTEL_EXTREME_TYPE_C_HDMI_CLOCK_H
+
+#include "AlderLakeTypeCBackend.h"
+
+// Injected-I/O helper for the ADL-P/N Type-C clock. Caller holds the port,
+// PLL and display power, and serializes all users of the shared clock register.
+// Callbacks must leave a register unchanged on a failed write.
+class TypeCHdmiClock {
+public:
+	TypeCHdmiClock(const AlderLakeTypeCIO& io, unsigned tcPort)
+		: fIO(io), fPort(tcPort), fSelectionChanged(false), fGateChanged(false),
+		  fSavedSelection(0), fSavedGate(0) {}
+
+	status_t Enable()
+	{
+		if (NeedsCleanup()) return B_BUSY;
+		if (fPort < 1 || fPort > 4 || fIO.read == NULL || fIO.write == NULL)
+			return B_BAD_VALUE;
+		uint32 value;
+		status_t status = Read(BufferOffset(), &value);
+		if (status != B_OK) return status;
+		if ((value & (1U << 31)) != 0) return B_BUSY;
+		if ((value & (1U << 6)) == 0) return B_ERROR;
+		status = Read(PllOffset(), &value);
+		if (status != B_OK) return status;
+		if ((value & ((1U << 31) | (1U << 30))) != ((1U << 31) | (1U << 30)))
+			return B_ERROR;
+		status = Read(ClockOffset(), &value);
+		if (status != B_OK) return status;
+		if ((value & kSelectionMask) != 0) return B_BUSY;
+		fSavedSelection = value & kSelectionMask;
+		status = fIO.write(fIO.cookie, ClockOffset(),
+			(value & ~kSelectionMask) | kMgSelection);
+		if (status != B_OK) return status;
+		fSelectionChanged = true;
+		status = Read(kGateOffset, &value);
+		if (status != B_OK) return Fail(status);
+		fSavedGate = value & GateMask();
+		status = fIO.write(fIO.cookie, kGateOffset, value & ~GateMask());
+		if (status != B_OK) return Fail(status);
+		fGateChanged = true;
+		status = Read(kGateOffset, &value);
+		if (status != B_OK || (value & GateMask()) != 0)
+			return Fail(status == B_OK ? B_ERROR : status);
+		return B_OK;
+	}
+
+	status_t Release()
+	{
+		uint32 value;
+		status_t status;
+		if (fGateChanged) {
+			status = Read(kGateOffset, &value);
+			if (status != B_OK) return status;
+			status = fIO.write(fIO.cookie, kGateOffset,
+				(value & ~GateMask()) | fSavedGate);
+			if (status != B_OK) return status;
+			fGateChanged = false;
+		}
+		if (fSelectionChanged) {
+			status = Read(ClockOffset(), &value);
+			if (status != B_OK) return status;
+			status = fIO.write(fIO.cookie, ClockOffset(),
+				(value & ~kSelectionMask) | fSavedSelection);
+			if (status != B_OK) return status;
+			fSelectionChanged = false;
+		}
+		return B_OK;
+	}
+
+	bool NeedsCleanup() const { return fSelectionChanged || fGateChanged; }
+
+private:
+	enum { kSelectionMask = 0xfU << 28, kMgSelection = 8U << 28,
+		kGateOffset = 0x164280 };
+	uint32 GateMask() const { return 1U << (fPort + 11); }
+	uint32 ClockOffset() const { return 0x4610cU + (fPort - 1) * 4U; }
+	uint32 BufferOffset() const { return 0x64300U + (fPort - 1) * 0x100U; }
+	uint32 PllOffset() const { return 0x46038U + (fPort - 1) * 8U; }
+	status_t Read(uint32 offset, uint32* value)
+	{
+		status_t status = fIO.read(fIO.cookie, offset, value);
+		return status == B_OK && *value == 0xffffffffU ? B_ERROR : status;
+	}
+	status_t Fail(status_t cause)
+	{
+		status_t cleanup = Release();
+		return cleanup == B_OK ? cause : cleanup;
+	}
+	TypeCHdmiClock(const TypeCHdmiClock&);
+	TypeCHdmiClock& operator=(const TypeCHdmiClock&);
+	AlderLakeTypeCIO fIO;
+	unsigned fPort;
+	bool fSelectionChanged, fGateChanged;
+	uint32 fSavedSelection, fSavedGate;
+};
+
+#endif
