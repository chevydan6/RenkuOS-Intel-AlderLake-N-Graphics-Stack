diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeCloneMmio.h b/src/add-ons/accelerants/intel_extreme/AlderLakeCloneMmio.h
new file mode 100644
index 00000000..dd7c8265
--- /dev/null
+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeCloneMmio.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef INTEL_EXTREME_ALDER_LAKE_CLONE_MMIO_H
+#define INTEL_EXTREME_ALDER_LAKE_CLONE_MMIO_H
+#include "AlderLakeTypeCBackend.h"
+#include <OS.h>
+// Existing validated BAR only. Reads require the caller's proven powered-pipe
+// mask. Writes are confined to pipe B's primary and its two scalers.
+class AlderLakeCloneMmio {
+public:
+	AlderLakeCloneMmio(volatile uint8* base, size_t size)
+		: fBase(base)
+		, fSize(size)
+		, fMask(0)
+	{
+	}
+	void SetPoweredPipes(uint32 mask)
+	{
+		fMask = mask & 15;
+	}
+	AlderLakeTypeCIO Ops()
+	{
+		AlderLakeTypeCIO io = { this, Read, Write, Pause };
+		return io;
+	}
+
+private:
+	bool Valid(uint32 o) const
+	{
+		return fBase && !(o & 3) && fSize >= 4 && o <= fSize - 4;
+	}
+	bool WriteAllowed(uint32 o) const
+	{
+		if (!(fMask & 2))
+			return false;
+		const uint32 offsets[] = { 0x6101c, 0x68980, 0x68974, 0x68a80, 0x68a74, 0x71180, 0x7119c,
+			0x71188, 0x7118c, 0x71190, 0x711a4, 0x711cc, 0x71240, 0x71244, 0x71248, 0x7124c,
+			0x71250, 0x71254, 0x71258, 0x7125c, 0x71268, 0x7127c };
+		for (unsigned i = 0; i < sizeof(offsets) / sizeof(offsets[0]); i++)
+			if (o == offsets[i])
+				return true;
+		return false;
+	}
+	bool ReadAllowed(uint32 o) const
+	{
+		if (o == 0x45404 || o == 0x45504 || o == 0x4438c || o == 0x45008 || o == 0x44fe8
+			|| o == 0x44300 || o == 0x44304 || o == 0x46010 || o == 0x164284 || o == 0x164288
+			|| o == 0x164b10 || o == 0x164280)
+			return true;
+		if (WriteAllowed(o))
+			return true;
+		for (unsigned pipe = 0; pipe < 4; pipe++) {
+			if (!(fMask & (1U << pipe)))
+				continue;
+			uint32 d = pipe * 0x1000;
+			if (o == 0x70008 + d || o == 0x70080 + d || o == 0x7017c + d || o == 0x70040 + d
+				|| o == 0x70064 + d || o == 0x60000 + d || o == 0x6000c + d || o == 0x6001c + d
+				|| o == 0x60040 + d || o == 0x60044 + d || o == 0x60400 + d || o == 0x7003c + d)
+				return true;
+			for (unsigned plane = 0; plane < 7; plane++) {
+				uint32 p = d + plane * 0x100;
+				if (o == 0x70180 + p || o == 0x7027c + p)
+					return true;
+			}
+			const uint32 primary[]
+				= { 0x701cc, 0x70188, 0x7018c, 0x70190, 0x701a4, 0x7019c, 0x70240, 0x70258 };
+			for (unsigned i = 0; i < sizeof(primary) / sizeof(primary[0]); i++)
+				if (o == primary[i] + d)
+					return true;
+		}
+		return false;
+	}
+	static status_t Read(void* p, uint32 o, uint32* v)
+	{
+		AlderLakeCloneMmio& m = *(AlderLakeCloneMmio*)p;
+		if (!v || !m.Valid(o) || !m.ReadAllowed(o))
+			return B_BAD_VALUE;
+		*v = *(volatile uint32*)(m.fBase + o);
+		return B_OK;
+	}
+	static status_t Write(void* p, uint32 o, uint32 v)
+	{
+		AlderLakeCloneMmio& m = *(AlderLakeCloneMmio*)p;
+		if (!m.Valid(o) || !m.WriteAllowed(o))
+			return B_BAD_VALUE;
+		*(volatile uint32*)(m.fBase + o) = v;
+		return B_OK;
+	}
+	static void Pause(void*)
+	{
+		snooze(10);
+	}
+	volatile uint8* fBase;
+	size_t fSize;
+	uint32 fMask;
+};
+#endif
diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeClonePlaneProgrammer.h b/src/add-ons/accelerants/intel_extreme/AlderLakeClonePlaneProgrammer.h
new file mode 100644
index 00000000..41c7e5db
--- /dev/null
+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeClonePlaneProgrammer.h
@@ -0,0 +1,187 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef INTEL_EXTREME_ALDER_LAKE_CLONE_PLANE_PROGRAMMER_H
+#define INTEL_EXTREME_ALDER_LAKE_CLONE_PLANE_PROGRAMMER_H
+#include "AlderLakePlaneClone.h"
+#include "AlderLakeTypeCBackend.h"
+
+// Pipe B primary only. Caller owns the display/pipe lease and has validated the
+// complete free DDB inventory, framebuffer backing and matching source plan.
+// Pipe B must keep running until Restore() has disabled/latch-drained its plane.
+class AlderLakeClonePlaneProgrammer {
+public:
+	AlderLakeClonePlaneProgrammer(const AlderLakeTypeCIO& io, unsigned attempts)
+		: fIO(io)
+		, fAttempts(attempts)
+		, fChanged(0)
+		, fEnabled(false)
+		, fControl(0)
+		, fSurface(0)
+		, fUnderrunBefore(0)
+		, fUnderrunAfter(0)
+	{
+	}
+	status_t Apply(const AlderLakeClonePlan& p)
+	{
+		if (NeedsCleanup())
+			return B_BUSY;
+		if (!fIO.read || !fIO.write || !fIO.pause || !fAttempts || p.ddb != 0x0fff0800U
+			|| p.minimumBlocks > 2048 || p.stride != 120 || p.size != 0x0437077f
+			|| p.pipeSize != 0x077f0437 || p.color != 0x2000 || (p.surface & 4095)
+			|| p.control != 0x94000008U)
+			return B_BAD_VALUE;
+		status_t s = Read(0x71180, &fControl);
+		if (s != B_OK)
+			return s;
+		if (fControl & 0x80000000U)
+			return B_BUSY;
+		s = Read(0x7119c, &fSurface);
+		if (s != B_OK)
+			return s;
+		if (fSurface != p.surface)
+			return B_BAD_VALUE;
+		for (unsigned i = 0; i < 20; i++) {
+			s = Read(Offset(i), &fSaved[i]);
+			if (s != B_OK)
+				return s;
+		}
+		if (fSaved[19] != 0)
+			return B_BUSY;
+		s = Read(0x71064, &fUnderrunBefore);
+		if (s != B_OK)
+			return s;
+		uint32 values[20] = { p.pipeSize, fSaved[1] & ~0x80000000U, 0, fSaved[3] & ~0x80000000U, 0,
+			p.stride, p.position, p.size, p.offset, p.color, p.wm0, 0, 0, 0, 0, 0, p.sagv, 0, 0,
+			p.ddb };
+		for (unsigned i = 0; i < 20; i++) {
+			s = fIO.write(fIO.cookie, Offset(i), values[i]);
+			if (s != B_OK)
+				return Fail(s);
+			fChanged |= 1U << i;
+		}
+		// Linux skl_plane_update_arm: control immediately before surface, because
+		// enabling an initially disabled control can self-arm.
+		s = fIO.write(fIO.cookie, 0x71180, p.control);
+		if (s != B_OK)
+			return Fail(s);
+		fEnabled = true;
+		s = fIO.write(fIO.cookie, 0x7119c, p.surface);
+		if (s != B_OK)
+			return Fail(s);
+		s = WaitFrame();
+		if (s != B_OK)
+			return Fail(s);
+		uint32 value;
+		s = Read(0x71180, &value);
+		if (s != B_OK)
+			return Fail(s);
+		if (!(value & 0x80000000U))
+			return Fail(B_ERROR);
+		s = Read(0x71064, &fUnderrunAfter);
+		if (s != B_OK)
+			return Fail(s);
+		if ((fUnderrunAfter & ~fUnderrunBefore) & 0x3f3f3f3fU)
+			return Fail(B_ERROR);
+		return B_OK;
+	}
+	status_t Restore()
+	{
+		if (fEnabled) {
+			status_t s = fIO.write(fIO.cookie, 0x71180, fControl & ~0x80000000U);
+			if (s != B_OK)
+				return s;
+			s = fIO.write(fIO.cookie, 0x7119c, fSurface);
+			if (s != B_OK)
+				return s;
+			s = WaitFrame();
+			if (s != B_OK)
+				return s;
+			fEnabled = false;
+		}
+		for (unsigned n = 20; n > 5; n--) {
+			unsigned i = n - 1;
+			if (!(fChanged & (1U << i)))
+				continue;
+			status_t s = fIO.write(fIO.cookie, Offset(i), fSaved[i]);
+			if (s != B_OK)
+				return s;
+			fChanged &= ~(1U << i);
+		}
+		// Scaler control first, window size last to arm the saved configuration.
+		for (unsigned n = 2; n > 0; n--) {
+			unsigned i = n == 2 ? 3 : 1;
+			uint32 bits = (1U << i) | (1U << (i + 1));
+			if (!(fChanged & bits))
+				continue;
+			status_t s = fIO.write(fIO.cookie, Offset(i), fSaved[i]);
+			if (s != B_OK)
+				return s;
+			s = fIO.write(fIO.cookie, Offset(i + 1), fSaved[i + 1]);
+			if (s != B_OK)
+				return s;
+			fChanged &= ~bits;
+		}
+		if (fChanged & 1) {
+			status_t s = fIO.write(fIO.cookie, Offset(0), fSaved[0]);
+			if (s != B_OK)
+				return s;
+			fChanged &= ~1U;
+		}
+		return B_OK;
+	}
+	bool NeedsCleanup() const
+	{
+		return fEnabled || fChanged;
+	}
+	uint32 UnderrunBefore() const
+	{
+		return fUnderrunBefore;
+	}
+	uint32 UnderrunAfter() const
+	{
+		return fUnderrunAfter;
+	}
+
+private:
+	static uint32 Offset(unsigned i)
+	{
+		const uint32 offsets[20] = { 0x6101c, 0x68980, 0x68974, 0x68a80, 0x68a74, 0x71188, 0x7118c,
+			0x71190, 0x711a4, 0x711cc, 0x71240, 0x71244, 0x71248, 0x7124c, 0x71250, 0x71254,
+			0x71258, 0x7125c, 0x71268, 0x7127c };
+		return offsets[i];
+	}
+	status_t Read(uint32 offset, uint32* value)
+	{
+		status_t s = fIO.read(fIO.cookie, offset, value);
+		return s == B_OK && *value == 0xffffffffU ? B_ERROR : s;
+	}
+	status_t WaitFrame()
+	{
+		uint32 before;
+		status_t s = Read(0x71040, &before);
+		if (s != B_OK)
+			return s;
+		for (unsigned i = 0; i < fAttempts; i++) {
+			uint32 value;
+			s = Read(0x71040, &value);
+			if (s != B_OK)
+				return s;
+			if (value != before)
+				return B_OK;
+			fIO.pause(fIO.cookie);
+		}
+		return B_TIMED_OUT;
+	}
+	status_t Fail(status_t cause)
+	{
+		status_t s = Restore();
+		return s == B_OK ? cause : s;
+	}
+	AlderLakeClonePlaneProgrammer(const AlderLakeClonePlaneProgrammer&);
+	AlderLakeClonePlaneProgrammer& operator=(const AlderLakeClonePlaneProgrammer&);
+	AlderLakeTypeCIO fIO;
+	unsigned fAttempts;
+	uint32 fChanged;
+	bool fEnabled;
+	uint32 fControl, fSurface, fSaved[20], fUnderrunBefore, fUnderrunAfter;
+};
+#endif
diff --git a/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiContext.h b/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiContext.h
index 2901e0b0..ec560e19 100644
--- a/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiContext.h
+++ b/src/add-ons/accelerants/intel_extreme/AlderLakeHdmiContext.h
@@ -1,13 +1,16 @@
 /* SPDX-License-Identifier: MIT */
 #ifndef INTEL_EXTREME_ALDER_LAKE_HDMI_CONTEXT_H
 #define INTEL_EXTREME_ALDER_LAKE_HDMI_CONTEXT_H
+#include "AlderLakeCloneMmio.h"
+#include "AlderLakeClonePlaneProgrammer.h"
 #include "AlderLakeHdmiFirmware.h"
 #include "AlderLakeHdmiSequence.h"
 #include "AlderLakeTypeCMmio.h"
 
 // Per-port diagnostic raster context. All methods require accelerant_lock.
-// Owns persistent pipe/port leases and shared power references. No planes are
-// enabled and no framebuffer is fetched. Caller validates firmware, mapping,
+// Owns persistent pipe/port leases and shared power references. Raster start
+// enables no planes; an optional validated Finish stage clones the primary.
+// Caller validates firmware, mapping,
 // mode flags and sink timing before construction.
 class AlderLakeHdmiContext {
 public:
@@ -15,6 +18,7 @@ public:
 		const AlderLakeHdmiFirmware& firmware, unsigned pipe)
 		: fFirmware(firmware)
 		, fPipeIndex(pipe)
+		, fShared(shared)
 		, fMmio(base, bytes, firmware.tcPort, pipe, true)
 		, fIO(fMmio.Ops())
 		, fWell(WellOps(this), firmware.tcPort, 500)
@@ -24,6 +28,11 @@ public:
 			  firmware.tcPort, pipe, 500)
 		, fPipe(fIO, pipe, 500)
 		, fSequence(fIO, fWell, fPortLease, firmware.tcPort, pipe, 500)
+		, fCloneMmio(base, bytes)
+		, fCloneIO(fCloneMmio.Ops())
+		, fClone(fCloneIO, 10000)
+		, fCloneRequested(false)
+		, fCloneAllocationBytes(0)
 		, fActive(false)
 		, fConfigured(false)
 		, fStopping(false)
@@ -91,7 +100,10 @@ public:
 	status_t Stop()
 	{
 		fStopping = true;
-		status_t s = fSequence.End();
+		status_t s = fClone.Restore();
+		if (s != B_OK)
+			return s;
+		s = fSequence.End();
 		if (s == B_OK) {
 			fActive = false;
 			fStopping = false;
@@ -106,7 +118,10 @@ public:
 			return B_OK;
 		if (!fConfigured)
 			return B_ERROR;
-		return Start(fTiming, fHSync, fVSync);
+		status_t status = Start(fTiming, fHSync, fVSync);
+		if (status == B_OK && fCloneRequested)
+			status = EnableClone(fCloneAllocationBytes);
+		return status;
 	}
 	bool IsActive() const
 	{
@@ -114,20 +129,189 @@ public:
 	}
 	bool NeedsCleanup() const
 	{
-		return fSequence.NeedsCleanup();
+		return fClone.NeedsCleanup() || fSequence.NeedsCleanup();
+	}
+	status_t EnableClone(uint32 allocationBytes)
+	{
+		fStage = "desktop validation";
+		if (!IsActive() || fPipeIndex != 1 || fClone.NeedsCleanup())
+			return B_BUSY;
+		uint32 main, dc;
+		status_t status = fIO.read(fIO.cookie, 0x45404U, &main);
+		if (status != B_OK)
+			return status;
+		status = fIO.read(fIO.cookie, 0x45504U, &dc);
+		if (status != B_OK || dc != 0 || main == 0xffffffffU)
+			return B_BUSY;
+		uint32 powered = 0;
+		for (unsigned pipe = 0; pipe < 4; pipe++) {
+			uint32 state = 1U << (2 * (pipe + 5));
+			if ((main & (state | 1U)) == (state | 1U))
+				powered |= 1U << pipe;
+		}
+		if ((powered & 3) != 3)
+			return B_BUSY;
+		fCloneMmio.SetPoweredPipes(powered);
+		// Wait for the source surface/stride update from this modeset to latch.
+		status = WaitSourceFrame();
+		if (status != B_OK)
+			return status;
+		const display_mode& mode = fShared.current_mode;
+		if (fShared.bits_per_pixel != 32 || mode.virtual_width != 1920
+			|| mode.virtual_height != 1080 || fShared.bytes_per_row != 7680
+			|| allocationBytes != 7680U * 1080U || !fShared.frame_buffer
+			|| (addr_t)fShared.frame_buffer < (addr_t)fShared.graphics_memory
+			|| (addr_t)fShared.frame_buffer - (addr_t)fShared.graphics_memory
+				!= fShared.frame_buffer_offset)
+			return B_BAD_VALUE;
+		AlderLakeCloneInput in = { };
+		in.frameBufferOffset = fShared.frame_buffer_offset;
+		in.allocationBytes = allocationBytes;
+		in.apertureBytes = fShared.graphics_memory_size;
+		in.width = 1920;
+		in.height = 1080;
+		in.bytesPerRow = fShared.bytes_per_row;
+		in.targetPixelCeilKHz = fFirmware.pixelClockKHz + 1;
+		fStage = "desktop source plane";
+		const uint32 offsets[] = { 0x70180, 0x701cc, 0x70188, 0x7018c, 0x70190, 0x701a4, 0x7019c,
+			0x70240, 0x70258, 0x60000, 0x61000, 0x6000c, 0x6100c, 0x6001c };
+		uint32* fields[] = { &in.sourceControl, &in.sourceColor, &in.sourceStride,
+			&in.sourcePosition, &in.sourceSize, &in.sourceOffset, &in.sourceSurface, &in.sourceWm0,
+			&in.sourceSagv, &in.sourceHTotal, &in.targetHTotal, &in.sourceVTotal, &in.targetVTotal,
+			&in.sourcePipeSize };
+		for (unsigned i = 0; i < B_COUNT_OF(offsets); i++) {
+			status = CloneRead(offsets[i], fields[i]);
+			if (status != B_OK)
+				return status;
+		}
+		fStage = "desktop clock proof";
+		uint32 cfg0, cfg1, pll, ssc, m, n, clock, trans;
+		if (CloneRead(0x46010, &pll) != B_OK || (pll & 0xcc000000U) != 0xcc000000U
+			|| CloneRead(0x164284, &cfg0) != B_OK || CloneRead(0x164288, &cfg1) != B_OK
+			|| CloneRead(0x164b10, &ssc) != B_OK || (ssc & 0x200U) || CloneRead(0x60040, &m) != B_OK
+			|| CloneRead(0x60044, &n) != B_OK || CloneRead(0x164280, &clock) != B_OK
+			|| (clock & (3U | (1U << 10))) || CloneRead(0x60400, &trans) != B_OK
+			|| (trans & 0xff700000U) != 0x8a000000U)
+			return B_BAD_VALUE;
+		status = DecodeAlderLakeComboPixelFloor(cfg0, cfg1, fFirmware.referenceKHz, m & 0xffffffU,
+			n & 0xffffffU, &in.sourcePixelFloorKHz);
+		if (status != B_OK)
+			return status;
+		fStage = "desktop DDB routing";
+		status = CloneRead(0x4438c, &in.mbusControl);
+		if (status != B_OK)
+			return status;
+		uint32 dbox;
+		if (CloneRead(0x7103c, &dbox) != B_OK || (dbox & 0x01ffff0fU) != 0x01038804U)
+			return B_BAD_VALUE;
+		const uint32 dbuf[] = { 0x45008, 0x44fe8, 0x44300, 0x44304 };
+		for (unsigned i = 0; i < 4; i++) {
+			uint32 value;
+			status = CloneRead(dbuf[i], &value);
+			if (status != B_OK)
+				return status;
+			if ((value & 0xc0000000U) == 0xc0000000U)
+				in.poweredSlices |= 1U << i;
+		}
+		in.ddbCount = 32;
+		for (unsigned pipe = 0; pipe < 4; pipe++) {
+			if (!(powered & (1U << pipe)))
+				continue;
+			uint32 control;
+			status = CloneRead(0x70008 + pipe * 0x1000, &control);
+			if (status != B_OK)
+				return status;
+			if (control & 0x80000000U)
+				in.activePipes |= 1U << pipe;
+			status = CloneRead(0x7017c + pipe * 0x1000, &in.ddb[pipe * 8 + 7]);
+			if (status != B_OK)
+				return status;
+			for (unsigned plane = 0; plane < 7; plane++) {
+				status
+					= CloneRead(0x7027c + pipe * 0x1000 + plane * 0x100, &in.ddb[pipe * 8 + plane]);
+				if (status != B_OK)
+					return status;
+				if (pipe == 1) {
+					status = CloneRead(0x70180 + pipe * 0x1000 + plane * 0x100, &control);
+					if (status != B_OK || (control & 0x80000000U))
+						return B_BUSY;
+				}
+			}
+		}
+		AlderLakeClonePlan plan;
+		status = BuildAlderLakeClonePlan(in, &plan);
+		if (status != B_OK)
+			return status;
+		fStage = "desktop plane programming";
+		status = fClone.Apply(plan);
+		if (status != B_OK && fClone.NeedsCleanup())
+			fStopping = true;
+		if (status == B_OK) {
+			fCloneRequested = true;
+			fCloneAllocationBytes = allocationBytes;
+		}
+		return status;
+	}
+	uint32 CloneUnderrunBefore() const
+	{
+		return fClone.UnderrunBefore();
+	}
