#include <IntelMemoryOwner.h>
#include <IntelApertureLeaseState.h>
#include <KernelExport.h>
#include <PCI.h>
#include <kernel/lock.h>

// Deliberately one retained N100 record. No publication, reset or in-place
// recovery entry point exists. Driver wiring is a separately reviewed step.
static mutex sLock;
static IntelApertureLeaseState sState;
static agp_gart_module_info* sGART;
static pci_module_info* sPCI;
static aperture_id sAperture = -1;
static intel_memory_owner_resources sResources;

static status_t
Status(IntelApertureLeaseState::Result result)
{
	switch (result) {
		case IntelApertureLeaseState::Success: return B_OK;
		case IntelApertureLeaseState::Busy: return B_BUSY;
		case IntelApertureLeaseState::Exhausted: return B_NO_MEMORY;
		default: return B_BAD_VALUE;
	}
}

// A ticket is ended under the owner mutex on every return path. Backend calls
// occur without this mutex; the pin and permanent module retain their targets.
class Operation {
public:
	Operation(uint64 lease, IntelApertureLeaseState::Access access)
		: fCanRetainBacking(access == IntelApertureLeaseState::Allocate
			|| access == IntelApertureLeaseState::Free),
		  fFailed(true)
	{
		mutex_lock(&sLock);
		fStatus = Status(sState.BeginOperation(lease, access, fTicket));
		mutex_unlock(&sLock);
	}
	~Operation()
	{
		if (fStatus != B_OK)
			return;
		mutex_lock(&sLock);
		sState.EndOperation(fTicket, fCanRetainBacking && fFailed);
		mutex_unlock(&sLock);
	}
	status_t InitCheck() const { return fStatus; }
	void Succeeded() { fFailed = false; }
private:
	Operation(const Operation&) = delete;
	Operation& operator=(const Operation&) = delete;
	IntelApertureLeaseState::Operation fTicket;
	status_t fStatus;
	bool fCanRetainBacking;
	bool fFailed;
};

static status_t
Query(uint64 lease, aperture_info* info)
{
	Operation operation(lease, IntelApertureLeaseState::Query);
	if (operation.InitCheck() != B_OK)
		return operation.InitCheck();
	if (info == NULL)
		return B_BAD_VALUE;
	return sGART->get_aperture_info(sAperture, info);
}

static status_t
Allocate(uint64 lease, size_t size, size_t alignment, uint32 flags,
	addr_t* base, phys_addr_t* physical)
{
	Operation operation(lease, IntelApertureLeaseState::Allocate);
	if (operation.InitCheck() != B_OK)
		return operation.InitCheck();
	status_t status = sGART->allocate_memory(sAperture, size, alignment,
		flags, base, physical);
	if (status == B_OK)
		operation.Succeeded();
	return status;
}

static status_t
Free(uint64 lease, addr_t base)
{
	Operation operation(lease, IntelApertureLeaseState::Free);
	if (operation.InitCheck() != B_OK)
		return operation.InitCheck();
	status_t status = sGART->free_memory(sAperture, base);
	if (status == B_OK)
		operation.Succeeded();
	return status;
}

static status_t
FinishDisplay(uint64 lease, bool initialized)
{
	mutex_lock(&sLock);
	status_t result = Status(sState.FinishInitialization(lease, initialized));
	mutex_unlock(&sLock);
	return result;
}

static status_t
ReleaseDisplay(uint64 lease)
{
	mutex_lock(&sLock);
	IntelApertureLeaseState::Result release = sState.Release(lease);
	if (release == IntelApertureLeaseState::Busy)
		release = sState.AbortInitialization(lease);
	status_t result = Status(release);
	mutex_unlock(&sLock);
	// Success means lease revocation, including aborted initialization.
	// Existing operation tickets still retain their pins until completion.
	// Last close is not scanout-idle evidence. Keep MMIO, GART and backing.
	return result;
}

static status_t
BeginDisplay(uint8 bus, uint8 device, uint8 function, uint64* lease,
	intel_memory_owner_resources* resources)
{
	if (lease == NULL || resources == NULL)
		return B_BAD_VALUE;
	// Copy identity from our own PCI module reference, not driver storage.
	pci_info pci;
	bool found = false;
	for (uint32 index = 0; sPCI->get_nth_pci_info(index, &pci) == B_OK; index++) {
		if (pci.bus == bus && pci.device == device && pci.function == function) {
			found = true;
			break;
		}
	}
	if (!found || pci.vendor_id != 0x8086 || pci.device_id != 0x46d1
		|| pci.revision != 0)
		return B_NOT_SUPPORTED;

	uint64 id = 0;
	mutex_lock(&sLock);
	status_t status = Status(sState.BeginInitialization(id));
	mutex_unlock(&sLock);
	if (status != B_OK)
		return status;

	// Initializing prevents concurrent acquire/release. The lease is not
	// returned until every required resource is owned by this module.
	addr_t apertureBase = 0;
	sAperture = sGART->map_aperture(bus, device, function, 0, &apertureBase);
	if (sAperture < B_OK)
		status = sAperture;
	else
		status = Query(id, &sResources.aperture);

	if (status == B_OK) {
		phys_addr_t base = pci.u.h0.base_registers[0];
		uint64 size = pci.u.h0.base_register_sizes[0];
		if ((pci.u.h0.base_register_flags[0] & PCI_address_type)
			== PCI_address_type_64) {
			base |= (uint64)pci.u.h0.base_registers[1] << 32;
			size |= (uint64)pci.u.h0.base_register_sizes[1] << 32;
		}
		if ((pci.u.h0.base_register_flags[0] & PCI_address_space) != 0
			|| base == 0 || (base & (B_PAGE_SIZE - 1)) != 0
			|| size == 0 || (size & (B_PAGE_SIZE - 1)) != 0
			|| size > SIZE_MAX || base > UINT64_MAX - size)
			status = B_BAD_VALUE;
		else {
			void* address = NULL;
			sResources.registers_area = map_physical_memory("intel owner mmio",
				base, (size_t)size, B_ANY_KERNEL_ADDRESS,
				B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA | B_CLONEABLE_AREA,
				&address);
			if (sResources.registers_area < B_OK)
				status = sResources.registers_area;
			else
				sResources.registers = (addr_t)address;
		}
	}
	if (status != B_OK) {
		// No guessed teardown of inherited scanout or partial acquisition.
		FinishDisplay(id, false);
		ReleaseDisplay(id);
		return status;
	}
	*resources = sResources;
	*lease = id;
	return B_OK;
}

static status_t
StandardOperations(int32 operation, ...)
{
	switch (operation) {
		case B_MODULE_INIT:
		{
			status_t status = get_module(B_PCI_MODULE_NAME, (module_info**)&sPCI);
			if (status != B_OK)
				return status;
			status = get_module(B_AGP_GART_MODULE_NAME, (module_info**)&sGART);
			if (status != B_OK) {
				put_module(B_PCI_MODULE_NAME);
				return status;
			}
			mutex_init(&sLock, "intel memory owner");
			sResources.registers_area = -1;
			return B_OK;
		}
		case B_MODULE_UNINIT:
			// No reviewed display-stop/hidden-backing recovery protocol exists.
			// B_KEEP_LOADED retains code as well as these module dependencies.
			return B_BUSY;
		default:
			return B_BAD_VALUE;
	}
}

static intel_memory_owner_module_info sModule = {
	{ INTEL_MEMORY_OWNER_MODULE_NAME, B_KEEP_LOADED, StandardOperations },
	BeginDisplay, FinishDisplay, ReleaseDisplay, Query, Allocate, Free
};

module_info* modules[] = { (module_info*)&sModule, NULL };
