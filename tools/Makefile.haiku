# SPDX-License-Identifier: MIT
# Native RenkuOS/Haiku x86_64 component build from an isolated source bundle.
CXX := g++
CC := gcc
SOURCE := source
OUT := build
PRIVATE := /boot/system/develop/headers/private
GRAPHICS := $(SOURCE)/headers/private/graphics
ACCEL := $(SOURCE)/src/add-ons/accelerants/intel_extreme
COMMON := $(SOURCE)/src/add-ons/accelerants/common
GART := $(SOURCE)/src/add-ons/kernel/busses/agp_gart
GART_MANAGER := $(SOURCE)/src/add-ons/kernel/bus_managers/agp_gart
DRIVER := $(SOURCE)/src/add-ons/kernel/drivers/graphics/intel_extreme
DRIVER_COMMON := $(SOURCE)/src/add-ons/kernel/drivers/graphics/common
GTT_TEST := $(if $(wildcard $(GART)/intel_gtt.h),$(OUT)/gtt-range-test)
PTE_TEST := $(if $(wildcard $(GART)/intel_gtt.h),$(OUT)/gtt-pte-test)
STOLEN_TEST := $(if $(wildcard $(GART)/intel_gtt.h),$(OUT)/gtt-stolen-test)
CPPFLAGS := -I$(GRAPHICS) -I$(GRAPHICS)/intel_extreme -I$(GRAPHICS)/common \
	-I$(PRIVATE)/shared
CXXFLAGS := -std=gnu++17 -O2 -g -Wall -fPIC -fno-exceptions -fno-rtti
CFLAGS := -O2 -g -Wall -fPIC
KERNELFLAGS := -D_KERNEL_MODE=1 -I$(PRIVATE) -I$(PRIVATE)/kernel -I$(PRIVATE)/drivers \
	-I$(PRIVATE)/system -I$(PRIVATE)/kernel/arch/x86 \
	-I$(PRIVATE)/system/arch/x86_64 \
	-I$(SOURCE)/build/config_headers \
	-ffreestanding -fno-use-cxa-atexit -fno-tree-vectorize -fno-strict-aliasing \
	-fno-delete-null-pointer-checks -mno-red-zone -fno-omit-frame-pointer
ACCEL_CPP := accelerant cursor dpms engine hooks memory mode overlay pll \
	FlexibleDisplayInterface PanelFitter Ports Pipes TigerLakePLL
COMMON_CPP := compute_display_timing create_display_modes dp validate_display_mode video_configuration
COMMON_C := ddc decode_edid dump_edid i2c
ACCEL_OBJECTS := $(addprefix $(OUT)/accel/,$(addsuffix .o,$(ACCEL_CPP)))
COMMON_OBJECTS := $(addprefix $(OUT)/common/,$(addsuffix .o,$(COMMON_CPP) $(COMMON_C)))
DRIVER_OBJECTS := $(addprefix $(OUT)/driver/,$(addsuffix .o,bios driver device intel_extreme power kernel_cpp))

.PHONY: all test check-platform
all: check-platform $(OUT)/gart-allocation-test
all: check-platform $(OUT)/intel_gart $(OUT)/agp_gart $(OUT)/intel_extreme.driver $(OUT)/intel_extreme.accelerant $(OUT)/hooks-test $(GTT_TEST) $(PTE_TEST) $(STOLEN_TEST) $(OUT)/lifecycle-test $(OUT)/intel_extreme.lifecycle.accelerant $(OUT)/gating-test $(OUT)/gart-range-test $(OUT)/gart-lifecycle-test

check-platform:
	@test "$$(uname -s)" = Haiku && test "$$(uname -m)" = x86_64

$(OUT)/intel_gart.o: $(GART)/intel_gart.cpp $(wildcard $(GART)/intel_gtt.h)
	mkdir -p $(OUT)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(KERNELFLAGS) -c $< -o $@

$(OUT)/intel_gart: $(OUT)/intel_gart.o Makefile
	$(CXX) -shared -nostdlib -Wl,--no-undefined -Wl,-soname,intel \
		-Wl,-z,max-page-size=0x1000 -o $@ $< \
		-L/boot/system/develop/lib -l:_KERNEL_ /boot/system/develop/lib/haiku_version_glue.o

$(OUT)/agp_gart.o: $(GART_MANAGER)/agp_gart.cpp
	mkdir -p $(OUT)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(KERNELFLAGS) -c $< -o $@

$(OUT)/agp_gart: $(OUT)/agp_gart.o $(OUT)/driver/kernel_cpp.o
	$(CXX) -shared -nostdlib -Wl,--no-undefined -Wl,-soname,agp_gart \
		-Wl,-z,max-page-size=0x1000 -o $@ $^ \
		-L/boot/system/develop/lib -l:_KERNEL_ /boot/system/develop/lib/haiku_version_glue.o

$(OUT)/driver/%.o: $(DRIVER)/%.cpp
	mkdir -p $(OUT)/driver
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(KERNELFLAGS) -I$(GRAPHICS)/vesa -c $< -o $@

$(OUT)/driver/kernel_cpp.o: $(SOURCE)/src/system/kernel/util/kernel_cpp.cpp
	mkdir -p $(OUT)/driver
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(KERNELFLAGS) -c $< -o $@

$(OUT)/driver/memory_manager.o: $(DRIVER_COMMON)/memory_manager.c
	mkdir -p $(OUT)/driver
	$(CC) $(CPPFLAGS) $(CFLAGS) $(filter-out -fno-use-cxa-atexit,$(KERNELFLAGS)) \
		-I$(GRAPHICS)/radeon -DENABLE_LOGGING -DLOG_INCLUDE_STARTUP -c $< -o $@

$(OUT)/driver/libgraphicscommon.a: $(OUT)/driver/memory_manager.o
	ar rcs $@ $<

$(OUT)/intel_extreme.driver: $(DRIVER_OBJECTS) $(OUT)/driver/libgraphicscommon.a
	$(CXX) -shared -nostdlib -Wl,--no-undefined -Wl,-soname,intel_extreme \
		-Wl,-z,max-page-size=0x1000 -o $@ $^ \
		-L/boot/system/develop/lib -l:_KERNEL_ /boot/system/develop/lib/haiku_version_glue.o

$(OUT)/accel/%.o: $(ACCEL)/%.cpp
	mkdir -p $(OUT)/accel
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

$(OUT)/common/%.o: $(COMMON)/%.cpp
	mkdir -p $(OUT)/common
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

$(OUT)/common/%.o: $(COMMON)/%.c
	mkdir -p $(OUT)/common
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(OUT)/intel_extreme.accelerant: $(ACCEL_OBJECTS) $(COMMON_OBJECTS)
	$(CXX) -shared -Wl,--no-undefined -o $@ $^ -lbe

$(OUT)/hooks-test: tests/hooks-test.cpp
	mkdir -p $(OUT)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -Wextra -Werror -Wno-unused-parameter \
		-Wno-missing-field-initializers \
		-I$(ACCEL) $< -o $@ -lbe

$(OUT)/control-hooks.o: controls/hooks.cpp
	mkdir -p $(OUT)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -I$(ACCEL) -c $< -o $@

$(OUT)/gtt-range-test: tests/gtt-range-test.cpp $(GART)/intel_gtt.h
	mkdir -p $(OUT)
	$(CXX) $(CXXFLAGS) -Wextra -Werror -I$(GART) $< -o $@

$(OUT)/gtt-pte-test: tests/gtt-pte-test.cpp $(GART)/intel_gtt.h
	mkdir -p $(OUT)
	$(CXX) $(CXXFLAGS) -Wextra -Werror -I$(GART) $< -o $@

$(OUT)/gtt-stolen-test: tests/gtt-stolen-test.cpp $(GART)/intel_gtt.h
	mkdir -p $(OUT)
	$(CXX) $(CXXFLAGS) -Wextra -Werror -I$(GART) $< -o $@

$(OUT)/intel_extreme.control.accelerant: $(filter-out $(OUT)/accel/hooks.o,$(ACCEL_OBJECTS)) $(COMMON_OBJECTS) $(OUT)/control-hooks.o
	$(CXX) -shared -Wl,--no-undefined -o $@ $^ -lbe

$(OUT)/lifecycle-export.o: tests/lifecycle-export.cpp
	mkdir -p $(OUT)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -I$(ACCEL) -c $< -o $@

$(OUT)/lifecycle-test: tests/lifecycle-test.cpp
	mkdir -p $(OUT)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -Wextra -Werror -Wno-unused-parameter \
		-Wno-missing-field-initializers -I$(ACCEL) $< -o $@ -lbe

$(OUT)/intel_extreme.lifecycle.accelerant: $(ACCEL_OBJECTS) $(COMMON_OBJECTS) $(OUT)/lifecycle-export.o
	$(CXX) -shared -Wl,--no-undefined -o $@ $^ -lbe

$(OUT)/control-engine.o: controls/engine.cpp
	mkdir -p $(OUT)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -I$(ACCEL) -c $< -o $@

$(OUT)/intel_extreme.lifecycle-control.accelerant: $(filter-out $(OUT)/accel/engine.o,$(ACCEL_OBJECTS)) $(COMMON_OBJECTS) $(OUT)/control-engine.o $(OUT)/lifecycle-export.o
	$(CXX) -shared -Wl,--no-undefined -o $@ $^ -lbe

$(OUT)/gating-test: tests/gating-test.cpp $(DRIVER)/power.cpp
	mkdir -p $(OUT)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(KERNELFLAGS) -I$(DRIVER) $< -o $@

$(OUT)/gating-control: tests/gating-test.cpp controls/power.cpp
	mkdir -p $(OUT)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(KERNELFLAGS) -I$(DRIVER) \
		-DGATING_SOURCE='"../controls/power.cpp"' $< -o $@

$(OUT)/gart-range-test: tests/gart-range-test.cpp tests/generated/gart-current.inc
	mkdir -p $(OUT)
	$(CXX) $(CXXFLAGS) -Wextra -Werror $< -o $@

$(OUT)/gart-range-control: tests/gart-range-test.cpp tests/generated/gart-original.inc
	mkdir -p $(OUT)
	$(CXX) $(CXXFLAGS) -Wextra -Werror \
		-DGART_METHODS='"generated/gart-original.inc"' $< -o $@

$(OUT)/gart-lifecycle-test: tests/gart-lifecycle-test.cpp tests/generated/gart-lifecycle-current.inc
	mkdir -p $(OUT)
	$(CXX) $(CXXFLAGS) -Wextra -Werror $< -o $@

$(OUT)/gart-lifecycle-control: tests/gart-lifecycle-test.cpp tests/generated/gart-lifecycle-original.inc
	mkdir -p $(OUT)
	$(CXX) $(CXXFLAGS) -Wextra -Werror -DGART_DELETE_RESULT=void -DGART_HAS_DELETE_ALL=0 \
		-DGART_LIFECYCLE_METHODS='"generated/gart-lifecycle-original.inc"' $< -o $@

$(OUT)/gart-allocation-test: tests/gart-allocation-test.cpp tests/generated/gart-allocation-current.inc
	mkdir -p $(OUT)
	$(CXX) $(CXXFLAGS) -Wextra -Werror $< -o $@

$(OUT)/gart-allocation-control: tests/gart-allocation-test.cpp tests/generated/gart-allocation-original.inc
	mkdir -p $(OUT)
	$(CXX) $(CXXFLAGS) -Wextra -Werror \
		-DGART_ALLOCATION_METHODS='"generated/gart-allocation-original.inc"' $< -o $@

test: all $(OUT)/intel_extreme.control.accelerant $(OUT)/intel_extreme.lifecycle-control.accelerant $(OUT)/gating-control $(OUT)/gart-range-control $(OUT)/gart-lifecycle-control $(OUT)/gart-allocation-control
	$(if $(GTT_TEST),$(GTT_TEST),@echo 'GGTT helper absent in unpatched control')
	$(if $(PTE_TEST),$(PTE_TEST),@echo 'GGTT PTE helper absent in unpatched control')
	$(if $(STOLEN_TEST),$(STOLEN_TEST),@echo 'GGC helper absent in unpatched control')
	python3 tests/source-audit.py source
	$(OUT)/hooks-test ./$(OUT)/intel_extreme.accelerant
	$(OUT)/lifecycle-test ./$(OUT)/intel_extreme.lifecycle.accelerant
	$(OUT)/gating-test
	$(OUT)/gart-range-test
	$(OUT)/gart-lifecycle-test
	$(OUT)/gart-allocation-test
	python3 tools/regression-control.py
	python3 tools/validate-artifacts.py $(OUT)
