# Patch context carries leading diff markers and signature separators.
*.patch -whitespace
# Preserve the sanitizer's raw shadow-byte legend in archived defect evidence.
tests/evidence/**/no-lock.log -whitespace
# Keep Mesa nir_print_shader output byte-identical, including its final blank line.
experimental/native-gpu/render/compiler/artifacts/*.nir whitespace=-blank-at-eof

# Preserve the exact generated Intel draw image and its manifest hash.
experimental/native-gpu/render/draw/RcsDrawGenerated.h whitespace=-blank-at-eol

# Preserve captured native ps output verbatim.
experimental/native-gpu/evidence/native-rcs-005/final-app-server.log whitespace=-blank-at-eol
