 	(module_info*)&sModule, (module_info*)&sObservationModule,
 	(module_info*)&sGtObservationModule, (module_info*)&sHandshakeModule,
 	(module_info*)&sEngineInventoryModule, (module_info*)&sMediaFuseModule,
