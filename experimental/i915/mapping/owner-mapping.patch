+// Memory-only GGTT sandbox. Private kernel pointers, never user input/output.
+// No engine publication is allowed: end_set is valid only because these buffers
+// can never be submitted through this interface. A future execution API needs
+// an independent device-DMA/cache/retirement contract before reusing them.
+#define INTEL_MEMORY_MAPPING_MODULE_NAME "bus_managers/intel_memory_owner/mapping/v1"
+#define INTEL_MEMORY_MAPPING_COUNT 4
+struct intel_memory_mapping_buffer {
+	addr_t cpu_aperture; // CPU aperture alias, not ordinary RAM or a DMA address
+	uint64 ggtt_offset; // GPU global virtual offset, not aperture BAR physical
+	size_t size;
+};
+struct intel_memory_mapping_set {
+	uint64 token;
+	intel_memory_mapping_buffer buffers[INTEL_MEMORY_MAPPING_COUNT];
+};
+struct intel_memory_mapping_module_info {
+	module_info info;
+	// Fixed ring/batch/result/context backing sizes: 4K/4K/4K/64K. These are
+	// diagnostic backing roles; this does not construct a valid hardware context.
+	// Begin publishes nothing on failure; uncertain backing stays resident.
+	status_t (*begin_set)(intel_memory_mapping_set* output);
+	// Caller must stop all CPU access before end. Failure retains the record and
+	// module; successful frees are recorded individually so retry cannot double free.
+	status_t (*end_set)(uint64 token);
+};
+
 #endif
diff --git a/src/add-ons/kernel/bus_managers/intel_memory_owner/IntelMemoryOwner.cpp b/src/add-ons/kernel/bus_managers/intel_memory_owner/IntelMemoryOwner.cpp
