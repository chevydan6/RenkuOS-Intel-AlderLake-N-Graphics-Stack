shader: MESA_SHADER_VERTEX
name: native_rcs_passthrough
internal: true
max_subgroup_size: 128
min_subgroup_size: 1
decl_var shader_in INTERP_MODE_NONE none vec4 position (VERT_ATTRIB_GENERIC0.xyzw, 0, 0)
decl_var shader_out INTERP_MODE_SMOOTH none vec4 gl_Position (VARYING_SLOT_POS.xyzw, 0, 0)
decl_function main () (entrypoint)

impl main {
    block b0:  // preds:
    32    %0 = deref_var &position (shader_in vec4)
    32    %1 = deref_var &gl_Position (shader_out vec4)
               @copy_deref (%1, %0) (dst_access=0, src_access=0)
               // succs: b1
    block b1:
}

