shader: MESA_SHADER_FRAGMENT
name: native_rcs_constant
internal: true
max_subgroup_size: 128
min_subgroup_size: 1
decl_var shader_out INTERP_MODE_NONE none vec4 color (FRAG_RESULT_DATA0.xyzw, 0, 0)
decl_function main () (entrypoint)

impl main {
    block b0:  // preds:
    32x4  %0 = load_const (0x3f800000, 0x3e800000, 0x00000000, 0x3f800000) = (1.000000, 0.250000, 0.000000, 1.000000)
    32    %1 = deref_var &color (shader_out vec4)
               @store_deref (%1, %0 (1.000000, 0.250000, 0.000000, 1.000000)) (wrmask=xyzw, access=none)
               // succs: b1
    block b1:
}

