shader: MESA_SHADER_VERTEX
source_blake3: {0x27b2e60c, 0x4d0cca39, 0x15a7cb29, 0x56aa88a7, 0x15284161, 0x262860b9, 0x0975fb3a, 0x9225a109}
max_subgroup_size: 128
min_subgroup_size: 1
decl_var shader_in INTERP_MODE_NONE none vec4 #0 (VERT_ATTRIB_GENERIC0.xyzw, 0, 0)
decl_var shader_out INTERP_MODE_NONE none block #1 (VARYING_SLOT_POS, 0, 0)
decl_function main () (entrypoint)

impl main {
    block b0:  // preds:
    32    %0 = deref_var &#0 (shader_in vec4)
    32x4  %1 = @load_deref (%0) (access=none)
    32    %2 = deref_var &#1 (shader_out block)
    32    %3 = deref_struct &%2->field0 (shader_out vec4)  // &#1.field0
               @store_deref (%3, %1) (wrmask=xyzw, access=none)
               return
               // succs: b1
    block b1:
}

